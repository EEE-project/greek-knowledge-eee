97", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "3.112", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "9.64", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(leg. κρυόεντος),"}, {"kind": "citation", "text": "3.133", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "9.440", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "10.8", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "1.165", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "3.165", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "4.240", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "9.604", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; π. Ἀχαιῶν, ἀνδρῶν, i.e. brought by them,"}, {"kind": "citation", "text": "3.165", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "24.8", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(pl.), etc.;"}, {"kind": "citation", "text": "ὁ τῶν βαρβάρων π. Th. 1.24", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "Ἑλλήνων π. X. HG 3.2.22", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὁ παρὼν π. Κορινθίων Th. 1.32", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ὁ μέλλων καὶ ὅσον οὐ παρὼν π. ib."}, {"kind": "citation", "text": "36", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὁ πρὸς Δαρεῖον π. Hdt. 6.2", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἀσχημοσύνῃ καὶ Ἔρωτι πρὸς ἀλλήλους ἀεὶ π. Pl. Smp. 196a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": "; Δωριακὸς π. Orac. ap."}, {"kind": "citation", "text": "Th. 2.54", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὁ Ἰωνικὸς π. Id. 8.11", "author_abbreviation": "Id.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὁ Φωκικὸς π. Aeschin. 3.148", "author_abbreviation": "Aeschin.", "tlg_author": "0026", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "π. Δεκελεικός Isoc. 8.37", "author_abbreviation": "Isoc.", "tlg_author": "0010", "tlg_work": "017", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "14.31", "author_abbreviation": null, "tlg_author": "0010", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "π. ξενικός Arist. Pol. 1272b20", "author_abbreviation": "Arist.", "tlg_author": "0086", "tlg_work": "035", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "δουλικοὶ π. Ath. 6.272f", "author_abbreviation": "Ath.", "tlg_author": "0008", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἱερὸς π. Ar. Av. 556", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ", etc.; πόλεμον ἄρασθαι levy war,"}, {"kind": "citation", "text": "A. Supp. 342", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Ar. Ach. 913", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.: c. dat.,"}, {"kind": "citation", "text": "ἢ τοῖσιν ἢ τοῖς π. αἴρεσθαι μέγαν A. Supp. 439", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "π. ἄρασθαι πρός τινας X. Cyr. 1.6.45", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "π. θέσθαι τινί E. Or. 13", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "016", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "π. ἀναιρέεσθαι Hdt. 5.36", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "D. 1.7", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; π. κινεῖν, ἐγεῖραι,"}, {"kind": "citation", "text": "Th. 6.34", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Hdn. 3.5.3", "author_abbreviation": "Hdn.", "tlg_author": "0015", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "π. τοῖς ἔργοις ἐξενήνοχε D. 11.20", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Plu. 2.829e", "author_abbreviation": "Plu.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐς π. καθίστασθαί τισι E. HF 1168", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "009", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "π. ἐπαγαγεῖν Aeschin. 3.140", "author_abbreviation": "Aeschin.", "tlg_author": "0026", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἀγαγεῖν ἐπί τινας D. 5.19", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "; π. ποιεῖν make war,"}, {"kind": "citation", "text": "Id. 8.7", "author_abbreviation": "Id.", "tlg_author": "0014", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": "; π. ποιεῖσθαι carry it on,"}, {"kind": "citation", "text": "X. An. 5.5.24", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; π. καταλύεσθαι put an end to it,"}, {"kind": "citation", "text": "And. 3.17", "author_abbreviation": "And.", "tlg_author": "0027", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Th. 6.36", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὁ π. ἀναπέπαυται X. Cyr. 7.5.47", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ": prov., οὐ πόλεμον ἐπαγγέλλεις, i.e. that is good news,"}, {"kind": "citation", "text": "Pl. Lg. 702d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "034", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Phdr. 242b", "author_abbreviation": null, "tlg_author": "0059", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": ": in pl.,"}, {"kind": "citation", "text": "Democr. 250", "author_abbreviation": "Democr.", "tlg_author": "0161", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "διὰ τὴν τῶν χρημάτων κτῆσιν πάντες οἱ π. ἡμῖν γίγνονται Pl. Phd. 66c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "R. 460a", "author_abbreviation": null, "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ", al. personified, War, Battle,"}, {"kind": "citation", "text": "Ἀλαλὰ Πολέμου θύγατερ Pi. Fr. 78", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Ar. Pax 205", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "; Π. πάντων μὲν πατήρ ἐστι,"}, {"kind": "citation", "text": "πάντων δὲ βασιλεύς Heraclit. 53", "author_abbreviation": "Heraclit.", "tlg_author": "1415", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὁ π. τῆς γενέσεως Dam. Pr. 423", "author_abbreviation": "Dam.", "tlg_author": "4066", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ". metaph. of womankind,"}, {"kind": "citation", "text": "πολυτελὴς π. Secund. Sent. 8", "author_abbreviation": "Secund.", "tlg_author": "1521", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "."}]}