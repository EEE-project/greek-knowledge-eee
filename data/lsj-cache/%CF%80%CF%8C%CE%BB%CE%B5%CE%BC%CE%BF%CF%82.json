{"format_version": 2, "segments": [{"kind": "text", "text": "πόλεμος, and πτόλεμος, ὁ, war,"}, {"kind": "citation", "text": "Il. 1.61", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc. (the usual meaning in post-Homeric Greek); also, battle, fight, ib."}, {"kind": "citation", "text": "226", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; even of single combat,"}, {"kind": "citation", "text": "7.174", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πόλεμοί τε μάχαι τε 1.177", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "5.891", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φυλόπιδος . . καὶ πολέμοιο 18.242", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἀϋτήν τε πτόλεμόν τε 1.492", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "14.37", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "96", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "π. καὶ δηϊοτῆτος 5.348", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.: periphr., νεῖκος, φύλοπις, ἔρις πολέμοιο,"}, {"kind": "citation", "text": "13.271", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001