xt": ", cf."}, {"kind": "citation", "text": "108", "author_abbreviation": null, "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "4.97", "author_abbreviation": null, "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": rarely c. part., εἰ τόδ' αὐτῷ φιλον κεκλημένῳ if it please him to be so called,"}, {"kind": "citation", "text": "A. Ag. 161", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "(lyr.): agreeing with pl.,"}, {"kind": "citation", "text": "αἰεί τοι τὰ κάκ' ἐστὶ φίλα φρεσὶ μαντεύεσθαι Il. 1.107", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Od. 17.15", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἔνθα φίλ' ὀπταλέα κρέα ἔδμεναι Il. 4.345", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "σοὶ δ' ἔργα φίλ' ἔστω μέτρια κοσμεῖν Hes. Op. 306", "author_abbreviation": "Hes.", "tlg_author": "0020", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ". in"}, {"kind": "citation", "text": "Hom.", "author_abbreviation": "Hom.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "and early Poets, one's own; freq. of limbs, life, etc., φίλον δ' ἐξαίνυτο θυμόν he took away dear life,"}, {"kind": "citation", "text": "Il. 5.155", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "22.58", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "κατεπλήγη φίλον ἦτορ 3.31", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "εἰς ὅ κε . . μοι φίλα γούνατ' ὀρώρῃ 9.610", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φίλον κατὰ λαιμόν 19.209", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; esp. of one's nearest kin,"}, {"kind": "citation", "text": "πατὴρ φ. 22.408", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Sapph. Supp. 20", "author_abbreviation": "Sapph.", "tlg_author": "0009", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "a."}, {"kind": "citation", "text": "11", "author_abbreviation": null, "tlg_author": "0009", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἄλοχος φ. Il. 5.480", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": cf. φίλτατος: as a standing epith. when no affection is implied, μητρὶ φίλῃ Ἀλθαίῃ χωόμενος κῆρ angry with his own mother,"}, {"kind": "citation", "text": "Il. 9.555", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": simply to denote possession,"}, {"kind": "citation", "text": "φίλα εἵματα 2.261", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; φ. πόνος their wonted labour,"}, {"kind": "citation", "text": "Theoc. 21.20", "author_abbreviation": "Theoc.", "tlg_author": "0005", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". applied to the numbers"}, {"kind": "citation", "text": "284", "author_abbreviation": null, "tlg_author": "0005", "tlg_work": "001", "dialects": []}, {"kind": "