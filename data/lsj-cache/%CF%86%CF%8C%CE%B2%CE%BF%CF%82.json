xt", "text": ";"}, {"kind": "citation", "text": "φόβου ἔξωθεν εἶναι Id. El. 901", "author_abbreviation": "Id.", "tlg_author": "0006", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἵνα φόβος εἴη στρατεύειν X. An. 2.4.3", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; οὐ φ. μὴ . ."}, {"kind": "citation", "text": "Id. Mem. 2.1.25", "author_abbreviation": "Id.", "tlg_author": "0032", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; φ. ἐστὶν ὅπως μὴ . ."}, {"kind": "citation", "text": "Pl. Smp. 193a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": "; but φόβος εἰ πείσω I fear I shall not persuade . . ,"}, {"kind": "citation", "text": "E. Med. 184", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "(anap.); ἡμέας ἔχειφ. τε καὶ δέος ὅκως χρὴ . ."}, {"kind": "citation", "text": "Hdt. 4.115", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(φόβος ἦν ὥστε μὴ τέγξαι is corrupt in"}, {"kind": "citation", "text": "E. IT 1380", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": "): adverbial usages, φόβῳ by or through fear,"}, {"kind": "citation", "text": "A. Supp. 786", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(lyr.),"}, {"kind": "citation", "text": "Th. 240", "author_abbreviation": null, "tlg_author": "0085", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "(lyr.), etc.;"}, {"kind": "citation", "text": "ἀνάγκῃ καὶ φ. Pl. R. 554d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ": with Preps., διὰ φόβον, διὰ τὸν φ.,"}, {"kind": "citation", "text":