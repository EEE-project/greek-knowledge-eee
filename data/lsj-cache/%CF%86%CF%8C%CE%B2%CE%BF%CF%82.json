{"format_version": 2, "segments": [{"kind": "text", "text": "φόβος, ὁ, (φέβομαι) panic flight, the usual sense in"}, {"kind": "citation", "text": "Hom.", "author_abbreviation": "Hom.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ", cf. Sch."}, {"kind": "citation", "text": "Il. 11.71", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(but cf."}, {"kind": "citation", "text": "φύζα, φόβου κρυόεντος ἑταίρη Il. 9.2", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "); once in"}, {"kind": "citation", "text": "Od.", "author_abbreviation": "Od.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "οἱ δ' ἔσχοντο φόβου 24.57", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; freq. in"}, {"kind": "citation", "text": "Il.", "author_abbreviation": "Il.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Δαναῶν γένετο ἰαχή τε φ. τε 15.396", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πρῶτος Πηνέλεως . . ἦρχε φόβοιο 17.597", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐς φόβον ἀνδρῶν 15.310", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; φόβονδε = φύγαδε, ἑστάμεναι κρατερῶς, μηδὲ τρωπᾶσθε φόβονδε ib."}, {"kind": "citation", "text": "666", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φόβονδ' ἔχε μώνυχας ἵππους 8.139", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; μή τι φόβονδ' ἀγόρευε counsel not to flight,"}, {"kind": "citation", "text": "5.252", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἀΐξαντα φόβονδε 17.579", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὦρσαν φόβον Δαναοῖς B. 12.145", "author_abbreviation": "B.", "tlg_author": "0199", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". Φόβος personified, as son of Ares,"}, {"kind": "citation", "text": "Il. 13.299", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "Δεῖμός τε Φ. τε 11.37", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "4.440", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "15.119", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Hes. Th. 934", "author_abbreviation": "Hes.", "tlg_author": "0020", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "A. Th. 45", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "; worshipped at Selinus,"}, {"kind": "citation", "text": "IG 14.268.2", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ". panic fear,"}, {"kind": "citation", "text": "[στρατῷ] φ. ἐμβάλλειν Hdt. 7.10", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "."}, {"kind": "citation", "text": "έ; ἐν τῷ γινομένῳ φ. Id. 9.69", "author_abbreviation": "Id.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; generally, fear, terror (distd. from δέος (q.v.)),"}, {"kind": "citation", "text": "τορὸς ὀρθόθριξ φ. A. Ch. 32", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "(lyr.);"}, {"kind": "citation", "text": "διάτορος φ. Id. Pr. 183", "author_abbreviation": "Id.", "tlg_author": "0085", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "(lyr.);"}, {"kind": "citation", "text": "ταρβόσυνος Id. Th. 240", "author_abbreviation": "Id.", "tlg_author": "0085", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "(lyr.);"}, {"kind": "citation", "text": "νεανικός E. Hipp. 1204", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "; joined with δέος and δεῖμα, v. sub vocc.; opp. θάρρος,"}, {"kind": "citation", "text": "Pl. Lg. 644c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "034", "dialects": []}, {"kind": "text", "text": "; sts. in milder sense, doubt, scruple,"}, {"kind": "citation", "text": "Pl. Phd. 101b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "; ἔχει πολλὴν ὑποψίαν καὶ φ. ὡς . ."}, {"kind": "citation", "text": "Id. Sph. 268a", "author_abbreviation": "Id.", "tlg_author": "0059", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ": also, awe, reverence, for a ruler or divine being,"}, {"kind": "citation", "text": "τοῦ ἡγεμόνος POxy. 1642.17", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(iii A.D.);"}, {"kind": "citation", "text": "θεοῦ LXX Ps. 35(36).1", "author_abbreviation": "LXX", "tlg_author": "0527", "tlg_work": "027", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "PLond. 2.418.4", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(iv A.D.):"}, {"kind": "citation", "text": "τοῦκυρίου Act.Ap. 931", "author_abbreviation": null, "tlg_author": "0031", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ".—Construction, a. c. gen. obj., fear or dread of . . ,"}, {"kind": "citation", "text": "A. Pers. 116", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "(lyr.),"}, {"kind": "citation", "text": "Th. 3.54", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "φ. τοῦ στρατεῦσαι X. An. 3.1.18", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ": c. dupl.gen.,"}, {"kind": "citation", "text": "ὀμμάτων εἰληφότας φόβον . . τῆς ἐμῆς ἐπεισόδου S. OC 730", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ": with Preps.,"}, {"kind": "citation", "text": "φ. ἀπό τινος X. An. 7.2.37", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "codd.;"}, {"kind": "citation", "text": "ὁ ἀπὸ τῶν πολεμίων φ. Id. Cyr. 3.3.53", "author_abbreviation": "Id.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "οὑξ ὀνειράτων φ. A. Ch. 929", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πρός τινος S. El. 783", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πρός τινας D. 16.10", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "016", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "25.93", "author_abbreviation": null, "tlg_author": "0014", "tlg_work": "025", "dialects": []}, {"kind": "text", "text": "; φ. περὶ τοῦ καρποῦ fear for or concerning . . ,"}, {"kind": "citation", "text": "Th. 4.88", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φ. ἑκάστων πέρι Pl. Phlb. 20b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "010", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὑπὲρ τοῦ μέλλοντος Th. 7.41", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τὸν ἐκ τῶν Ἑλλήνων εἰς τοὺς βαρβάρους φ. X. An. 1.2.18", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; τῷ καθ' ἑαντὸν φ. from personal fear,"}, {"kind": "citation", "text": "D. 19.2", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "019", "dialects": []}, {"kind": "text", "text": ": c. inf., φόβῳ εἰσορᾶν from fear to see,"}, {"kind": "citation", "text": "E. IT 1342", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": ":—for τεθνάναι τῷ φόβῳ τινά, v. θνῄσκω 1.2. with Verbs,"}, {"kind": "citation", "text": "τεύχειν φόβον A. Pr. 1090", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "(anap.);"}, {"kind": "citation", "text": "κλάζουσι κώδωνες φ. Id. Th. 386", "author_abbreviation": "Id.", "tlg_author": "0085", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φ. ποιεῖν τοῖς ἵπποις X. An. 1.8.18", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "παρασχεῖν E. Hec. 1113", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "παρασκευάζειν D. 59.86", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "059", "dialects": []}, {"kind": "text", "text": "; φόβους ἐμβάλλειν, φόβον ἐνθεῖναί τινι, to strike terror into one,"}, {"kind": "citation", "text": "X. Cyr. 8.7.18", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "An. 7.4.1", "author_abbreviation": null, "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐνεργάσασθαί τινι Isoc. 7.38", "author_abbreviation": "Isoc.", "tlg_author": "0010", "tlg_work": "018", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "11.25", "author_abbreviation": null, "tlg_author": "0010", "tlg_work": "010", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἔδωκ' Ἀπόλλων θῆρας φόβῳ Pi. P. 5.61", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; of the person who feels fear, φόβον λαβεῖν, ἔχειν,"}, {"kind": "citation", "text": "E. El. 39", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "X. Hier. 11.11", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐκ φόβου φ. τρέφω S. Tr. 28", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": acc. cogn., φόβους φοβεῖσθαι, δεδοικέναι,"}, {"kind": "citation", "text": "Pl. Prt. 360b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "022", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "E. Supp. 548", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": "; τὸν σὸν οὐ ταρβῶ φ. I fear not with thy fear, i.e. not like thee,"}, {"kind": "citation", "text": "S. Ph. 1251", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; Ταντάλου φ. φοβεῖσθαι Sch."}, {"kind": "citation", "text": "E. Or. 6", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "016", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐς φ. κατιστέατο Hdt. 8.12", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Th. 2.81", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐν φ. γενέσθαι Pl. R. 578e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φ. μ' ἔχει A. Ag. 1243", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "E. Or. 1255", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "016", "dialects": []}, {"kind": "text", "text": "; μοι φ. τις εἰσελήλυθ', μ' ὑπῆλθέ τις φ., ib."}, {"kind": "citation", "text": "1324", "author_abbreviation": null, "tlg_author": "0006", "tlg_work": "016", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "S. Ph. 1231", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τοῖς Ἕλλησι φ. ἐμπίπτει X. An. 2.2.19", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ", etc.; διὰ φ