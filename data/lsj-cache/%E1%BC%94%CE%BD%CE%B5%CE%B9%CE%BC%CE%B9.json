lg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", al.;"}, {"kind": "citation", "text": "οὐκ ἔνι ἐν ὑμῖν οὐδεὶς σοφός 1 Ep.Cor. 6.5", "author_abbreviation": null, "tlg_author": "0031", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ". c. Adv.loci,"}, {"kind": "citation", "text": "οἴκοι ἔνεστι γόος Il. 24.240", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἔνεστιν αὐτόθι is in this very place,"}, {"kind": "citation", "text": "Ar. Eq. 119", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐνταῦθα Id. Nu. 211", "author_abbreviation": "Id.", "tlg_author": "0019", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ", etc. abs., to be present in a place,"}, {"kind": "citation", "text": "οἶνος ἐνέην Od. 9.164", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; οὐδ' ἄνδρες νηῶν ἔνι τέκτονες ib."}, {"kind": "citation", "text": "126", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "οὐδ' ἔνι στάσις A. Pers. 738", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "(troch.);"}, {"kind": "citation", "text": "Ἄρης οὐκ ἔνι χώρᾳ Id. Ag. 78", "author_abbreviation": "Id.", "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "(anap.); σίτου οὐκ ἐνόντος as there was no corn there,"}, {"kind": "citation", "text": "Th. 4.8", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; τὰ ἐνόντα ἀγαθά the good that is therein, ib."}, {"kind": "citation", "text": "20", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἱερῶν τῶν ἐνόντων the temples that were in the place, ib."}, {"kind": "citation", "text": "97", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἀμέλειά τις ἐνῆν καὶ διατριβή Id. 5.38", "author_abbreviation": "Id.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πόλεμος οὐκ ἐνῆν Pl. Plt. 271e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "μηδὲ μύλαν ἐνεῖμεν μηδὲ ὅλμον IG 22", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ".l.c.; also, to be mentioned in a treaty,"}, {"kind": "citation", "text": "Th. 8.43", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Ar. Av. 974", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; χρόνος ἐνέσται time will be necessary,"}, {"kind": "citation", "text": "Th. 1.80", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἡ βὴξ ἔνι the cough is persistent,"}, {"kind": "citation", "text": "Hp. Epid. 7.12", "author_abbreviation": "Hp.", "tlg_author": "0627", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ". to be possible,"}, {"kind": "citation", "text": "ἄρνησις οὐκ ἔ. ὧν ἀνιστορεῖς S. OT 578", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τῶνδ' ἄρνησις οὐκ ἔ. μοι Id. El. 527", "author_abbreviation": "Id.", "tlg_author": "0011", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "; τίς δ' ἔνεστί μοι λόγος; what plea is possible for 