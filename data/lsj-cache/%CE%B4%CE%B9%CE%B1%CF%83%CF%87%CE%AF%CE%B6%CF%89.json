{"format_version": 2, "segments": [{"kind": "text", "text": " δια-σχίζω, cleave asunder, sever, "}, {"kind": "citation", "text": "ἱστία δέ σφιν . . διέσχισεν ἲς ἀνέμοιο Od. 9.71", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐάν τις ἓν δ. Pl. Phd. 97a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ", etc.:— Pass. , to be cloven asunder, "}, {"kind": "citation", "text": "νεῦρα διεσχίσθη Il. 16.316", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; opp. συγκρίνεσθαι, "}, {"kind": "citation", "text": "Pl. Lg. 893e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "034", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "θοἰμάτιον δ. Id. Grg. 469d", "author_abbreviation": "Id.", "tlg_author": "0059", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": "; of soldiers, to be separated, parted, "}, {"kind": "citation", "text": "X. Cyr. 4.5.13", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": "; to be set at variance, "}, {"kind": "citation", "text": "διέσχιστο ἡ πόλις Charito 6.1", "author_abbreviation": "Charito", "tlg_author": "0554", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": impers., τούτοις διέσχισται they have a cleft, "}, {"kind": "citation", "text": "Arist. Resp. 475a2", "author_abbreviation": "Arist.", "tlg_author": "0086", "tlg_work": "037", "dialects": []}, {"kind": "text", "text": ". "}]}