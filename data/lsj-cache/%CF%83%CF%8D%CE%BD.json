text", "text": ";"}, {"kind": "citation", "text": "ς. θεῷ δ' εἰρήσεται Ar. Pl. 114", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ς. θεῷ εἰπεῖν Pl. Tht. 151b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Prt. 317b", "author_abbreviation": null, "tlg_author": "0059", "tlg_work": "022", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ξ. θεοῖς Th. 1.86", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; so ς. δαίμονι, ς. Ἀθήνῃ καὶ Διί,"}, {"kind": "citation", "text": "Il. 11.792", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "20.192", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ς. Χαρίτεσσιν Pi. N. 9.54", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "P. 9.2", "author_abbreviation": null, "tlg_author": "0033", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ξ. τῷ θεῷ πᾶς καὶ γελᾷ κὠδύρεται S. Aj. 383", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; also θεοῦ ς. παλάμᾳ, ς. θεοῦ τύχᾳ,"}, {"kind": "citation", "text": "Pi. O. 10(11).21", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "N. 6.24", "author_abbreviation": null, "tlg_author": "0033", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ": generally, of personal cooperation, ς. σοὶ φρα