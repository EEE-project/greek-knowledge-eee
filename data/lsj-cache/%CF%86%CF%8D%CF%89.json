", "tlg_author": "0059", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": ": construed with gen., πεφμκέναι or φῦναί τινος to be born or descended from any one,"}, {"kind": "citation", "text": "τὸ κοινὸν σπλάγχνον οὗ πεφύκαμεν A. Th. 1036", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "S. OC 1379", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "θνατᾶς ἀπὸ ματρὸς ἔφυ Pi. Fr. 61", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "S. OT 1359", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "(lyr.),"}, {"kind": "citation", "text": "Ant. 562", "author_abbreviation": null, "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἀπ' εὐγενοῦς ῥίζης E. IT 610", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἀπὸ δρυός Pl. Ap. 34d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "φ. ἔκ τινος S. OT 458", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "E. Heracl. 325", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Pl. R. 415c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "ἐκ χώρας τινός Isoc. 4.24", "author_abbreviation": "Isoc.", "tlg_author": "0010", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": ", etc.; οἱ μετ' ἐκείνου φύντες, opp. οἱ ἐξ ἐκείνου γεγονότες,"}, {"kind": "citation", "text": "Is. 8.30", "author_abbreviation": "Is.", "tlg_author": "0017", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐκ θεῶν γεγονότι . . διὰ βασιλέων πεφυκότι X. Cyr. 7.2.24", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ". in pres., become, οὐδεὶς ἐχθρὸς οὔτε φύεται πρὸς χρήμαθ' οἵ τε φύντες . ."}, {"kind": "citation", "text": "S. Fr. 88.4", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πιστοὺς φύσει φύεσθαι X. Cyr. 8.7.13", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": "; the pf. and aor. 2 take a pres. sense, to be so and so by nature, κακός, σοφός πέφυκα (-κώς), etc.,"}, {"kind": "citation", "text": "S. Ph. 558", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "1244", "author_abbreviation": null, "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "δρᾶν ἔφυν ἀμήχανος Id. Ant. 79", "author_abbreviation": "Id.", "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; φύντ' ἀρετᾷ born for virtue, i.e. brave and good by nature,"}, {"kind": "citation", "text": "Pi. O. 10(11).20", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; so of things,"}, {"kind": "citation", "text": "τὸ μὲν εὖ πράσσειν ἀκόρεστον ἔφυ A. Ag. 1331", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "(anap.), cf."}, {"kind": "citation", "text": "Pl. Grg. 479d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "εὐχροώτεροι ὁρῷντο ἢ πεφύκασιν X. Cyr. 8.1.41", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Oec. 10.2", "author_abbreviation": null, "tlg_author": "0032", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; ["}, {"kind": "citation", "text": "τὸ πῦρ] πέφυκε τοιοῦτον Id. Cyr. 5.1.10", "author_abbreviation": "Id.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τἄλλα ἕκαστος ἡμῶν, ὅπως ἔτυχε, πέφυκεν D. 37.56", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "037", "dialects": []}, {"kind": "text", "text": ": with Advs., ἱκανῶς πεφυκότες of good natural ability,"}, {"kind": "citation", "text": "Antipho 2.1.1", "author_abbreviation": "Antipho", "tlg_author": "0028", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "δυσκόλως πεφ. Isoc. 9.6", "author_abbreviation": "Isoc.", "tlg_author": "0010", "tlg_work": "015", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "οὕτως πεφ. X. HG 7.1.7", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; also"}, {"kind": "citation", "text": "οἱ καλῶς πεφυκότες S. El. 989", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Lys. 2.20", "author_abbreviation": "Lys.", "tlg_author": "0540", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "οἱ βέλτιστα φύντες Pl. R. 431c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ": then, simply, to be so and so,"}, {"kind": "citation", "text": "φῦναι Ζηνὶ πιστὸν ἄγγελον A. Pr. 969", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "θεοῦ μήτηρ ἔφυς Id. Pers. 157", "author_abbreviation": "Id.", "tlg_author": "0085", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "(troch.);"}, {"kind": "citation", "text": "γυναῖκε . . ἔφυμεν S. Ant. 62", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; Ἅιδης ὁ παύσων ἔφυ ib."}, {"kind": "citation", "text": "575", "author_abbreviation": null, "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἁπλοῦς ὁ μῦθος τῆς ἀληθείας ἔφυ E. Ph. 469", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "015", "dialects": []}, {"kind": "text", "text": ": c. part.,"}, {"kind": "citation", "text": "νικᾶν . . χρῄζων ἔφυν S. Ph. 1052", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πρέπων ἔφυς . . φωνεῖν Id. OT 9", "author_abbreviation": "Id.", "tlg_author": "0011", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "587", "author_abbreviation": null, "tlg_author": "0011", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τοῦτο ἴδιον ἔφυμεν ἔχοντες Isoc. 4.48", "author_abbreviation": "Isoc.", "tlg_author": "0010", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "11.41", "author_abbreviation": null, "tlg_author": "0010", "tlg_work": "010", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "X. Smp. 4.54", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ". c. inf., to be formed or disposed by nature to do so and so,"}, {"kind": "citation", "text": "τὰ δεύτερα πέφυκε κρατεῖν Pi. Fr. 279", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πολλῷ γ' ἀμείνων τοὺς πέλας φρενοῦν ἔφυς ἢ σαυτόν A. Pr. 337", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἔφυν γὰρ οὐδὲν ἐκ τέχνης πράσσειν κακῆς S. Ph. 88", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Ant. 688", "author_abbreviation": null, "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φύσει μὴ πεφυκότα τοιαῦτα φωνεῖν Id. Ph. 79", "author_abbreviation": "Id.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πεφύκασι δ' ἅπαντες . . ἁμαρτάνειν Th. 3.45", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "2.64", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "3.39", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "4.61", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "πέφυκε . . τρυφὴ . . ἦθος διαφθείρειν Jul. Or. 1.15c", "author_abbreviation": "Jul.", "tlg_author": "2003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". with Preps., γυνὴ . . ἐπὶ δακρύοις ἔφυ is by nature prone to tears,"}, {"kind": "citation", "text": "E. Med. 928", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; ἔρως γὰρ ἀργόν, κἀπὶ τοῖς ἀργοῖς ἔφυ is inclined to idleness,"}, {"kind": "citation", "text": "Id. Fr. 322", "author_abbreviation": "Id.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "; also"}, {"kind": "citation", "text": "ἐπί τι Pl. R. 507e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "εἴς τι Aeschin. 3.132", "author_abbreviation": "Aeschin.", "tlg_author": "0026", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; most freq."}, {"kind": "citation", "text": "πρός τι, οἱ ἄνθρωποι πρὸς τὸ ἀληθὲς πεφύκασι Arist. Rh. 1355a16", "author_abbreviation": "Arist.", "tlg_author": "0086", "tlg_work": "038", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "εὖ πρὸς ἀρετὴν πεφυκότες X. Mem. 4.1.2", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πρὸς πόλεμον μᾶλλον . . ἢ πρὸς εἰρήνην Pl. R. 547e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "κάλλιστα φ. πρός τι X. HG 7.1.3", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; also"}, {"kind": "citation", "text": "πρός τινι Id. Ath. 2.19", "author_abbreviation": "Id.", "tlg_author": "0032", "tlg_work": "015", "dialects": []}, {"kind": "text", "text": "(s. v.l., cf."}, {"kind": "citation", "text": "Plb. 9.29.10", "author_abbreviation": "Plb.", "tlg_author": "0543", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "); also"}, {"kind": "citation", "text": "εὖ πεφ. κατά τι D. 37.55", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "037", "dialects": []}, {"kind": "text", "text": ". c. dat., fall to one by nature, be one's natural lot,"}, {"kind": "citation", "text": "πᾶσι θνατοῖς ἔφυ μόρος S. El. 860", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "(lyr.);"}, {"kind": "citation", "text": "χαίρειν πέφυκεν οὐχὶ τοῖς αὐτοῖς ἀεί Id. Tr. 440", "author_abbreviation": "Id.", "tlg_author": "0011", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐφύετο κοινὸς πᾶσι κίνδυνος D. 60.18", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "060", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "X. Cyr. 4.3.19", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ". impers., it is natural, it happens naturally, c. inf.,"}, {"kind": "citation", "text": "D. 14.30", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "014", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Arist. Pol. 1261b7", "author_abbreviation": "Arist.", "tlg_author": "0086", "tlg_work": "035", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Po. 1450a1", "author_abbreviation": null, "tlg_author": "0086", "tlg_work": "034", "dialects": []}, {"kind": "text", "text": ". abs., ὡς πέφυκε as is natural,"}, {"kind": "citation", "text": "X. Cyn. 6.15", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "014", "dialects": []}, {"kind": "text", "text": ", al.;"}, {"kind": "citation", "text": "ᾗ πέφυκεν Pl. Ti. 81e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "031", "dialects": []}, {"kind": "text", "text": "; also expressed personally,"}, {"kind": "citation", "text": "τοῖς ἁπλῶς, ὡς πεφυκασι, βαδίζουσι D. 45.68", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "045", "dialects": []}, {"kind": "text", "text": ": also freq. in part., τὰ φύσει πεφυκότα the order of nature,"}, {"kind": "citation", "text": "Lys. 2.29", "author_abbreviation": "Lys.", "tlg_author": "0540", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; φύντα, opp. ὁμολογηθέντα,"}, {"kind": "citation", "text": "Antipho Soph. 44", "author_abbreviation": "Antipho Soph.", "tlg_author": "1147", "tlg_work": "001", "dialects": []}, {"kind": "citation", "text": "A i 32", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "("}, {"kind": "citation", "text": "Vorsokr. 5", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "); ἄνθρωπος πεφυκώς man as he is,"}, {"kind": "citation", "text": "X. Cyr. 1.1.3", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ". (Cf. Skt. bhū- 'to be, become', Lith. búti 'to be', Lat. fui, Eng. be, etc.)"}]}