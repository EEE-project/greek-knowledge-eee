k": "008", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τὰν Διὸς μῆτιν φ. A. Pr. 906", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "(lyr.);"}, {"kind": "citation", "text": "ὀσμὴν . . , μὴ βάλῃ, πεφευγότες S. Ant. 412", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φεύγων φυγῇ τὸ γῆρας Pl. Smp. 195b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐς πόντον . . φύγε πέτρας νηῦς Od. 10.131", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; οὐδεμία [πόλισ] πέφευγε (sed fort. leg. ἀπέφυγε) δουλοσύνην πρὸς Ἱπποκράτεος at the hands of . . ,"}, {"kind": "citation", "text": "Hdt. 7.154", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": part. pf. Pass. also retains the acc. in"}, {"kind": "citation", "text": "Hom.", "author_abbreviation": "Hom.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "in periphrastic phrases,"}, {"kind": "citation", "text": "μοῖραν δ' οὔ τινά φημι πεφυγμένον ἔμμεναι ἀνδρῶν Il. 6.488", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πεφυγμένον ἔμμεν ὄλεθρον Od. 9.455", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "οὔ οἱ νῦν ἔτι γ' ἔστι πεφυγμένον ἄμμε γενέσθαι Il. 22.219", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "h.Ven. 34", "author_abbreviation": null, "tlg_author": "0013", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ":—but in pass. sense, τὸ πάραυτα πεφυγμένον κακόν Epicur.l.c. seek to avoid, shirk,"}, {"kind": "citation", "text": "στρατείαν D. 21.162", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "021", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "εἰ τοῦτο φεύξονται καὶ μὴ 'θελήσουσι ποιεῖν Id. 20.138", "author_abbreviation": "Id.", "tlg_author": "0014", "tlg_work": "020", "dialects": []}, {"kind": "text", "text": "; so in aor.,"}, {"kind": "citation", "text": "ἢν φύγῃ τις, ζημιοῦν Ar. Ach. 717", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". of things,"}, {"kind": "citation", "text": "ἡνίοχον φύγον ἡνία escaped, slipped from his hands, Il. 23.465", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "Νέστορα δ' ἐκ χειρῶν φύγον ἡνία 8.137", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "11.128", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; τὸ φεῦγον the part which slips,"}, {"kind": "citation", "text": "X. Eq. 10.9", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Hp. Off. 9", "author_abbreviation": "Hp.", "tlg_author": "0627", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Gal. 18(2).735", "author_abbreviation": "Gal.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ": c. dupl. acc.,"}, {"kind": "citation", "text": "ποῖόν σε ἔπος φύγεν ἕρκος ὀδόντων Il. 4.350", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Od. 1.64", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", etc. of wine, 'go off', turn sour,"}, {"kind": "citation", "text": "Gp. 7.7.8", "author_abbreviation": "Gp.", "tlg_author": "4080", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". flee one's country,"}, {"kind": "citation", "text": "Il. 9.478", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Od. 13.259", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; οἱ φεύγοντες the exiles,"}, {"kind": "citation", "text": "Th. 1.24", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "X. Ages. 7.6", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "009", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πατρίδα φ. Od. 15.228", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "X. Cyr. 3.1.24", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τὴν αὑτοῦ Th. 5.26", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἅπασαν τὴν Ἀθηναίων ξυμμαχίδα IG 12.10.30", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φ. ἐξ Ἄργεος Od. 15.224", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Th. 8.85", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἐξ Ἀθηνέων, ἐκ τῆς πατρίδος,"}, {"kind": "citation", "text": "Hdt. 6.103", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "X. An. 1.3.3", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ". φ. ὑπὸ Σκυθέων to be expelled, driven out by . ."}, {"kind": "citation", "text": "Hdt. 4.125", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": but esp. to be exiled,"}, {"kind": "citation", "text": "φ. ὑπὸ τοῦ δήμου Id. 5.30", "author_abbreviation": "Id.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "X. HG 1.1.27", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; φ. ἐξ Ἀρείου πάγου by their sentence,"}, {"kind": "citation", "text": "Din. 1.44", "author_abbreviation": "Din.", "tlg_author": "0029", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": also c. acc.,"}, {"kind": "citation", "text": "φ. Πεισιστρατίδας Hdt. 5.62", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". abs., go into exile, live in banishment,"}, {"kind": "citation", "text": "A. Ag. 1668", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "(troch.),"}, {"kind": "citation", "text": "Antipho 2.2.9", "author_abbreviation": "Antipho", "tlg_author": "0028", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Pl. Mx. 242b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "028", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "δύο ἔτη φευγέτω Id. Lg. 867c", "author_abbreviation": "Id.", "tlg_author": "0059", "tlg_work": "034", "dialects": []}, {"kind": "text", "text": "; φ. ἀειφυγίαν to be banished for life, ib."}, {"kind": "citation", "text": "871d", "author_abbreviation": null, "tlg_author": "0059", "tlg_work": "034", "dialects": []}, {"kind": "text", "text": ", al.;"}, {"kind": "citation", "text": "φεόγειν Ἀμφίπολιν ἀειφυγίην SIG 194.3", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "24", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(Amphipolis, iv B. C.); but also"}, {"kind": "citation", "text": "ἐν ἀειφυγίᾳ Pl. Lg. 877e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "034", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φεύγων ἀπ' οἴκων ἃς ἐγὼ φεύγω φυγάς E. Andr. 976", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; φεύγοντες being in exile, opp."}, {"kind": "citation", "text": "φυγόντες having gone into exile, Lys. 14.33", "author_abbreviation": "Lys.", "tlg_author": "0540", "tlg_work": "014", "dialects": []}, {"kind": "text", "text": "; with play on words, \"μέχρι τίνος φεύξῃ, Ἀρκαδίων;\" καὶ ὅς, \"ἔς τ' ἂν τοὺς ἀφίκωμαι οἳ οὐκ ἴσασι Φίλιππον\""}, {"kind": "citation", "text": "Duris 3", "author_abbreviation": "Duris", "tlg_author": "0178", "tlg_work": "001", "dialects": []}, {"kind": "citation", "text": "J.", "author_abbreviation": "J.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "as law-term (mostly in pres. and impf., but cf."}, {"kind": "citation", "text": "Lys. 12.4", "author_abbreviation": "Lys.", "tlg_author": "0540", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": "(v. infr.)), to be accused or prosecuted at law: ὁ φεύγων the accused, defendant,"}, {"kind": "citation", "text": "Ar. V. 893", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Pl. R. 405b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ", etc.; opp."}, {"kind": "citation", "text": "διώκω, οὔτε φεύγων ἁλοὺς οὔτε διώκων ἡττηθείς D. 23.66", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": "; c. acc., φ. γραφάς, δίκην,"}, {"kind": "citation", "text": "Ar. Eq. 442", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "(lyr.),"}, {"kind": "citation", "text": "Nu. 167", "author_abbreviation": null, "tlg_author": "0019", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὑπό τινος δίκας φ. Pl. Ap. 19c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "D. 49.1", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "049", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "οὐδενὶ πώποτε οὔτε ἡμεῖς οὔτε ἐκεῖνος δίκην οὔτε ἐδικασάμεθα οὔτε ἐφύγομεν Lys.", "author_abbreviation": "Lys.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "l. c.;"}, {"kind": "citation", "text": "φ. ἀπολογίας Aeschin. 3.201", "author_abbreviation": "Aeschin.", "tlg_author": "0026", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; the crime being added in gen.,"}, {"kind": "citation", "text": "φόνου δίκην φ. Antipho 5.9", "author_abbreviation": "Antipho", "tlg_author": "0028", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "γραφὰς φ. παρανόμων D. 18.235", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "018", "dialects": []}, {"kind": "text", "text": "; more freq. c. gen. only, φ. φόνου to be charged with murder,"}, {"kind": "citation", "text": "Lys. 10.31", "author_abbreviation": "Lys.", "tlg_author": "0540", "tlg_work": "010", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Lycurg. 133", "author_abbreviation": "Lycurg.", "tlg_author": "0034", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "φ. δειλίας Ar. Ach. 1129", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ξενίας Id. V. 718", "author_abbreviation": "Id.", "tlg_author": "0019", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "(anap.); with gen. of the penalty,"}, {"kind": "citation", "text": "ἐὰν . . φεύγῃ δεσμῶν OGI 218.92", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(Ilium, iii B. C.); also"}, {"kind": "citation", "text": "περὶ θανάτου φ. Antipho 5.95", "author_abbreviation": "Antipho", "tlg_author": "0028", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φ. ἐπὶ μηνύσει τινός And. 1.18", "author_abbreviation": "And.", "tlg_author": "0027", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἀσεβείας φ. ὑπό τινος is accused of impiety by . . ,"}, {"kind": "citation", "text": "Pl. Ap. 35d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; rarely of things, τὸ φεῦγον ψήφισμα the decree that is on its defence, the decree in question,"}, {"kind": "citation", "text": "D. 23.58", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": ":—in"}, {"kind": "citation", "text": "Hdt. 7.214", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "αἰτίην φ. has the older sense, flee from a charge, quit one's country on account of a charge. plead in defence, δεῖ τοί σε φεύγειν . . ὡς οὐκ ἔχουσι κῦρος [οἱ νόμοι]"}, {"kind": "citation", "text": "A. Supp. 390", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἔφευγε μὴ εἰδέναι pleaded ignorance,"}, {"kind": "citation", "text": "S. Ant. 263", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", (Cf. Lat.fugio, Goth. biugan 'bend', etc.)"}]}