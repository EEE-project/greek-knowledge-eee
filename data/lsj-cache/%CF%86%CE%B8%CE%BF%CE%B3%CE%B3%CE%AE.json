{"format_version": 2, "segments": [{"kind": "text", "text": "φθογγ-ή, ἡ, poet. form of φθόγγος, voice of men,"}, {"kind": "citation", "text": "Il. 2.791", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "A. Supp. 197", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; of the Sirens, v.l. for φθόγγον in"}, {"kind": "citation", "text": "Od. 12.198", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "οἶκος εἰ φθογγὴν λάβοι σαφέστατ' ἂν λέξειεν A. Ag. 37", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "E. Hipp. 418", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τῶν ἁλόντων καὶ κρατησάντων . . φθογγάς A. Ag. 325", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "; of the voice of Orpheus, ἦγε πάντ' ἀπὸ φθογγῆς ib."}, {"kind": "citation", "text": "1630", "author_abbreviation": null, "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "βάλλει με . . φ. του S. Ph. 206", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "(lyr.); of birds and animals,"}, {"kind": "citation", "text": "ὥστ' ἀηδόνος στόμα φθογγὰς ἱεῖσα E. Hec. 338", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φ. ὀΐων τε καὶ αἰγῶν Od. 9.167", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "μόσχων E. IT 293", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": "(pl.)."}]}