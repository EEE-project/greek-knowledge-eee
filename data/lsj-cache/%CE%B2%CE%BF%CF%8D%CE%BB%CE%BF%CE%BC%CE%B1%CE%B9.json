{"format_version": 2, "segments": [{"kind": "text", "text": " βούλομαι (Ep. also βόλομαι, q. v.), βώλ- (q. v.), βόλλ- (v. βόλομαι), Thess. βέλλ- "}, {"kind": "citation", "text": "IG 9(2).517.20", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Aeol."]}, {"kind": "text", "text": ", βείλ- ib."}, {"kind": "citation", "text": "7.3080", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Boeot."]}, {"kind": "text", "text": ", βήλ- "}, {"kind": "citation", "text": "SIG 1185.18", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Boeot."]}, {"kind": "text", "text": " (Tanagra, iii B. C.), Locr. and Delph. δείλ- "}, {"kind": "citation", "text": "IG 9(1).334.3", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Boeot."]}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "GDI 2034.10", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Boeot."]}, {"kind": "text", "text": ", Coan, etc. δήλ- (q. v.), 2 sg. Ion. "}, {"kind": "citation", "text": "βούλεαι Od. 18.364", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Hdt. 1.11", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": impf. "}, {"kind": "citation", "text": "ἐβουλόμην Il. 11.79", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; "}, {"kind": "citation", "text": "ἠβουλόμην E. Hel. 752", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "014", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "D. 1.15", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; 3 pl. ἐβουλέατο codd. in "}, {"kind": "citation", "text": "Hdt. 1.4", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": ["Ion."]}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "3.143", "author_abbreviation": null, "tlg_author": "0016", "tlg_work": "001", "dialects": ["Ion."]}, {"kind": "text", "text": ": fut. "}, {"kind": "citation", "text": "βουλήσομαι A. Pr. 867", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "003", "dialects": ["Ion."]}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "S. OT 1077", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "004", "dialects": ["Ion."]}, {"kind": "text", "text": ", etc.; later fut. βουληθήσομαι v.l. in "}, {"kind": "citation", "text": "Aristid. Or. 48(24).8", "author_abbreviation": "Aristid.", "tlg_author": "0284", "tlg_work": "001", "dialects": ["Ion."]}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Gal. 13.636", "author_abbreviation": "Gal.", "tlg_author": null, "tlg_work": null, "dialects": ["Ion."]}, {"kind": "text", "text": ": aor. ἐβουλήθην, also ἠβ- (v. infr.), "}, {"kind": "citation", "text": "βουληθείς S. OC 732", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "007", "dialects": ["Ion."]}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "IG 22.1236", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Ion."]}, {"kind": "text", "text": ", etc., but aor. subj. 3 sg. βούλεται (from Βόλσ-ε-ται) "}, {"kind": "citation", "text": "Il. 1.67", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": ": pf. "}, {"kind": "citation", "text": "βεβούλημαι D. 18.2", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "018", "dialects": ["Ep."]}, {"kind": "text", "text": "; also βέβουλα (προ-) "}, {"kind": "citation", "text": "Il. 1.113", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": " (ἐβέβουλε dub. in Epigr. in "}, {"kind": "citation", "text": "Berl.Sitzb. 1894.907", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": "):— forms with augm. ἠ- are found in Att. Inscrr. from "}, {"kind": "citation", "text": "300", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": " B.C. onwards, as "}, {"kind": "citation", "text": "IG 22.657", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": ", al., and occur frequently in Mss. as ἠβούλοντο v.l.in "}, {"kind": "citation", "text": "Th. 2.2", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "6.79", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "ἠβούλου Hyp. Lyc. 11", "author_abbreviation": "Hyp.", "tlg_author": "0030", "tlg_work": "002", "dialects": ["Ep."]}, {"kind": "text", "text": "; said to be Ionic in "}, {"kind": "citation", "text": "An.Ox. 2.374", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": ".— An Act. βούλητε ( = βούλησθε ) Mitteis "}, {"kind": "citation", "text": "Chr. 361.10", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": " (iv A. D.):— will, wish, be willing, "}, {"kind": "citation", "text": "Hom.", "author_abbreviation": "Hom.", "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": ", etc.: usu. implying choice or preference (cf. IV) opp. ἐθέλω 'consent', "}, {"kind": "citation", "text": "εἰ βούλει, ἐγὼ ἐθέλω Pl. Grg. 522e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "023", "dialects": ["Ep."]}, {"kind": "text", "text": ", cf. "}, {"kind": "citation", "text": "R. 347b", "author_abbreviation": null, "tlg_author": "0059", "tlg_work": "030", "dialects": ["Ep."]}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "437b", "author_abbreviation": null, "tlg_author": "0059", "tlg_work": "030", "dialects": ["Ep."]}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐὰν βούλῃ σὺ . . ἐὰν θεὸς ἐθέλῃ Id. Alc. 1.135d", "author_abbreviation": "Id.", "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἂν οἵ τε θεοὶ 'θέλωσι καὶ ὑμεῖς βούλησθε D. 2.20", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "002", "dialects": ["Ep."]}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "οὔτ' ἀκούειν ἠθέλετ' οὔτε πιστεύειν ἐβούλεσθε Id. 19.23", "author_abbreviation": "Id.", "tlg_author": "0014", "tlg_work": "019", "dialects": ["Ep."]}, {"kind": "text", "text": "; but ἐθέλω is also used = 'wish', λέξαι θέλω σοι, πρὶν θανεῖν, ἃ βούλομαι, "}, {"kind": "citation", "text": "E. Alc. 281", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "002", "dialects": ["Ep."]}, {"kind": "text", "text": " (so "}, {"kind": "citation", "text": "ἐθέλω εἰπεῖν Pl. Prt. 309b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "022", "dialects": ["Ep."]}, {"kind": "text", "text": ", but "}, {"kind": "citation", "text": "φράσαι τι βούλομαι Ar. Pl. 1090", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "011", "dialects": ["Ep."]}, {"kind": "text", "text": "): "}, {"kind": "citation", "text": "Hom.", "author_abbreviation": "Hom.", "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": " uses βούλομαι for ἐθέλω in the case of the gods, for with them wish is will: ἐθέλω is more general, and is sts. used where βούλομαι might have stood, e.g. "}, {"kind": "citation", "text": "Il. 7.182", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": ".—Construct.: mostly c. inf., "}, {"kind": "citation", "text": "Τρώεσσιν ἐβούλετο κῦδος ὀρέξαι 11.79", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": ", etc.; sts. c. inf. fut., "}, {"kind": "citation", "text": "Thgn. 184", "author_abbreviation": "Thgn.", "tlg_author": null, "tlg_work": null, "dialects": ["Ep."]}, {"kind": "text", "text": "; c. acc. et inf., "}, {"kind": "citation", "text": "Od. 4.353", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": ["Ep."]}, {"kind": "text", "text": ", and freq. in Prose: when βούλομαι is folld. by acc. only, an inf. may generally be supplied, as καί κε τὸ βουλοίμην (sc. γενέσθαι) "}, {"kind": "citation", "text": "Od. 20.316", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": ["Ep."]}, {"kind": "text", "text": "; ἔτυχεν ὧν ἐβούλετο (sc. τυχεῖν) "}, {"kind": "citation", "text": "Antiph. 18.6", "author_abbreviation": "Antiph.", "tlg_author": "0410", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": "; πλακοῦντα β. (sc. σε λέγειν) "}, {"kind": "citation", "text": "Id. 52.11", "author_abbreviation": "Id.", "tlg_author": "0410", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": "; καὶ εἰ μάλα βούλεται ἄλλῃ [Ποσειδάων] (sc. τοῦτο γενέσθαι) "}, {"kind": "citation", "text": "Il. 15.51", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": "; so εἰς τὸ βαλανεῖον βούλομαι (sc. ἰέναι) "}, {"kind": "citation", "text": "Ar. Ra. 1279", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "009", "dialects": ["Ep."]}, {"kind": "text", "text": "; βουλοίμην ἄν (sc. τόδε γενέσθαι) "}, {"kind": "citation", "text": "Pl. Euthphr. 3a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": ". in "}, {"kind": "citation", "text": "Hom.", "author_abbreviation": "Hom.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": " of gods, c. acc. rei et dat. pers., Τρώεσσιν . . ἐβούλετο νίκην he willed victory to the Trojans, "}, {"kind": "citation", "text": "Il. 7.21", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf. "}, {"kind": "citation", "text": "23.682", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": later c. acc., τὸ βουλόμενον τὴν πολιτείαν πλῆθος that supports the constitution, "}, {"kind": "citation", "text": "Arist. Pol. 1309b17", "author_abbreviation": "Arist.", "tlg_author": "0086", "tlg_work": "035", "dialects": []}, {"kind": "text", "text": ". Att. usages: βούλει or βούλεσθε folld. by Verb in subj., βούλει λάβωμαι; would you have me take hold? "}, {"kind": "citation", "text": "S. Ph. 761", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; βούλει φράσω; "}, {"kind": "citation", "text": "Ar. Eq. 36", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", cf. "}, {"kind": "citation", "text": "Pl. Phd. 79a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "R. 596a", "author_abbreviation": null, "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": "; ποῦ δὴ βούλει ἀναγνῶμεν; "}, {"kind": "citation", "text": "Id. Phdr. 228e", "author_abbreviation": "Id.", "tlg_author": "0059", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": ". εἰ βούλει if you please, "}, {"kind": "citation", "text": "S. Ant. 1168", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "X. An. 3.4.41", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; also εἰ δὲ βούλει, ἐὰν δὲ βούλῃ, to express a concession, or if you like, "}, {"kind": "citation", "text": "Pl. Smp. 201a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": ", etc.; "}, {"kind": "citation", "text": "εἰ μὲν β., φρονήσει, εἰ δὲ β., ἰσχύι Id. R. 432a", "author_abbreviation": "Id.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ". ὁ βουλόμενος any one who likes, "}, {"kind": "citation", "text": "Hdt. 1.54", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Th. 1.26", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; "}, {"kind": "citation", "text": "ἔδωκεν ἅπαντι τῷ βουλομένῳ D. 21.45", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "021", "dialects": []}, {"kind": "text", "text": "; ὁ β. the 'common in former', "}, {"kind": "citation", "text": "Ar. Pl. 918", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": " (whence, in jest, βούλομαι ib."}, {"kind": "citation", "text": "908", "author_abbreviation": null, "tlg_author": "0019", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": "); ὅστις βούλει who or which ever you like, "}, {"kind": "citation", "text": "Pl. Grg. 517b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Cra. 432a", "author_abbreviation": null, "tlg_author": "0059", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ". βουλομένῳ μοί ἐστι, c. inf., it is according to my wish that . . , "}, {"kind": "citation", "text": "Th. 2.3", "autho