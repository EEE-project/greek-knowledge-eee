uthor": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ᾗ τινι δὴ γνώμῃ Th. 8.87", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; also "}, {"kind": "citation", "text": "ὅ τι δήκοτε πρήξοντα Hdt. 6.134", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ὅστις δήποτ' ὤν Pl. Phdr. 273c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ὡς ἀπετύγχαν' ὁτουδήποτε D. 19.167", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "019", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ὁτῳδήτινι τρόπῳ PFay. 21.11", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": " (ii A. D.); so ὁστισοῦν, ὁτιοῦν anybody (anything) whatsoever, "}, {"kind": "citation", "text": "Th. 4.16", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Pl. Smp. 198b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": ", etc.; "}, {"kind": "citation", "text": "μετὰ ὁτουοῦν τρόπου Th. 8.27", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ὁτῳοῦν Pl. Tht. 175a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; εἷς ὁστισοῦν any one person, "}, {"kind": "citation", "text": "Arist. Pol. 1286a31", "author_abbreviation": "Arist.", "tlg_author": "0086", "tlg_work": "035", "dialects": []}, {"kind": "text", "text": ": freq. with neg., "}, {"kind": "citation", "text":