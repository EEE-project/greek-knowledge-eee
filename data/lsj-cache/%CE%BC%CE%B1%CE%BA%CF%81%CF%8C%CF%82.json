or": "0410", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; also by μακράν (v. sub voc.); or by neut. with a Prep., v. supr."}, {"kind": "citation", "text": "111", "author_abbreviation": null, "tlg_author": "0410", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": for Comp. and Sup. of the Adv., v. μακροτέρως, μακροτάτω : neut. pl. -ότερα as Adv.,"}, {"kind": "citation", "text": "Pl. Phdr. 250c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": ", al.— Fem. μακρά not to be confused with μάκρα (q. v.). (Cf. Avest. mas-'long', Lat. ma^cer.)"}]}