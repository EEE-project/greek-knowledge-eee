}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Eu. 65", "author_abbreviation": null, "tlg_author": "0085", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": "; but "}, {"kind": "citation", "text": "ἐ. χωρεῖν Id. Th. 59", "author_abbreviation": "Id.", "tlg_author": "0085", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ": c. gen., "}, {"kind": "citation", "text": "οἱ ἐγγυτάτω τῆς ἀγορᾶς κατεσκευασμένοι Lys. 24.20", "author_abbreviation": "Lys.", "tlg_author": "0540", "tlg_work": "024", "dialects": []}, {"kind": "text", "text": ", etc. of Time, nigh at hand, "}, {"kind": "citation", "text": "Il. 22.453", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐ. ἡμῖν ὁ ἀγών X. Cyr. 2.3.2", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ". of Numbers, etc., nearly, "}, {"kind": "citation", "text": "ἔτεσι ἐ. εἴκοσι Th. 6.5", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "μισθὸς ἐ. ἐνιαυτοῦ X. HG 3.1.28", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": generally, nearly, almost, "}, {"kind": "citation", "text": "ἐ. ἔγνως S. Ichn. 301", "author_abbreviation": "S.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "; οὐδ' ἐ. τινος not nearly, i. e. not by a great deal, nothing like it, "}, {"kind": "citation", "text": "Pl. Smp. 198b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": "; ἔχει οὐχ οὕτω ταῦτα οὐδ' ἐ. not so . . nor yet nearly so, "}, {"kind": "citation", "text": "D. 21.30", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "021", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "οὐκ ἐποίουν τοῦτο, οὐδ' ἐ. Id. 18.96", "author_abbreviation": "Id.", "tlg_author": "0014", "tlg_work": "018", "dialects": []}, {"kind": "text", "text": "; mostly, "}, {"kind": "citation", "text": "Hp. Mochl. 34", "author_abbreviation": "Hp.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ". of Qualities, coming near, "}, {"kind": "citation", "text": "ἐ. τι καὶ παραπλήσιον Pl. Grg. 520a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": "; ἐγγύτατα τοῦ νῦν τρόπου, τῆς ξυμπάσης γνώμης, "}, {"kind": "citation", "text": "Th. 1.13", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "22", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ὅτι ἐγγύτατα τούτων Id. 7.86", "author_abbreviation": "Id.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "κοινῇ δὲ πᾶσιν οὐδεὶς ἐγγυτέρω D. 18.288", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "018", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "δοκεῖς δηλῶσαι ἐγγύτατα τὴν ῥητορικήν Pl. Grg. 452e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": "; ἐ. εἶναι, c. gen., "}, {"kind": "citation", "text": "Id. Phd. 116b", "author_abbreviation": "Id.", "tlg_author": "0059", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐ. τυφλῶν Id. R. 508c", "author_abbreviation": "Id.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": "; ἐ. τι τείνειν τοῦ τεθνάναι very near death, "}, {"kind": "citation", "text": "Id. Phd. 65a", "author_abbreviation": "Id.", "tlg_author": "0059", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "κακῶς παθεῖν ἐγγύτατα D. 21.123", "author_abbreviation": "D.", "tlg_author": "0014", "tlg_work": "021", "dialects": []}, {"kind": "text", "text": ". of Relationship, akin to, "}, {"kind": "citation", "text": "οἱ Ζηνὸς ἐ. A. Fr. 162", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": "; ἐγγυτέρω γένει or γένους, "}, {"kind": "citation", "text": "Pl. Ap. 30a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Is. 3.72", "author_abbreviation": "Is.", "tlg_author": "0017", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐγγύτατα γένους A. Supp. 388", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Lys. Fr. 41", "author_abbreviation": "Lys.", "tlg_author": "0540", "tlg_work": "036", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Pl. Hp.Ma. 304d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "025", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐγγυτάτω γένους IG 12.77", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Ar. Av. 1666", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ". "}]}