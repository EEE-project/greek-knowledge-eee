{"format_version": 2, "segments": [{"kind": "text", "text": "πούς, ὁ , ποδός, ποδί, πόδα (not ποῦν, Thom.Mag."}, {"kind": "citation", "text": "p.257", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "R.): dat.pl. ποσί, Ep. and Lyr. ποσσί (also"}, {"kind": "citation", "text": "Cratin. 100", "author_abbreviation": "Cratin.", "tlg_author": "0434", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(lyr.)), πόδεσσι, once"}, {"kind": "citation", "text": "πόδεσι S. Fr. 240", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": "(lyr.): gen.and dat. dual ποδοῖν,"}, {"kind": "citation", "text": "ποδοῖιν Il. 18.537", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": ["Ep."]}, {"kind": "text", "text": ":—Dor. nom. πός (cf. ἀρτίπος, πούλυπος, etc.)"}, {"kind": "citation", "text": "Lyr.Adesp. 72", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ", but πούς"}, {"kind": "citation", "text": "Tab.Heracl. 2.34", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(perh. Hellenistic); πῶς· πός, ὑπὸ Δωριέων,"}, {"kind": "citation", "text": "Hsch.", "author_abbreviation": "Hsch.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(fort. πός· πούς, ὑ.Δ.); πόρ, Id. (on the accent v. Hdn.Gr."}, {"kind": "citation", "text": "2.921", "author_abbreviation": null, "tlg_author": "4085", "tlg_work": "001", "dialects": ["Lacon."]}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "A.D. Adv. 134.24", "author_abbreviation": "A.D.", "tlg_author": "0082", "tlg_work": "002", "dialects": ["Lacon."]}, {"kind": "text", "text": "):—foot, both of men and beasts,"}, {"kind": "citation", "text": "Il. 7.212", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": ["Lacon."]}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "8.339", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": ["Lacon."]}, {"kind": "text", "text": "(both pl.), etc.; in pl., also, a bird's talons,"}, {"kind": "citation", "text": "Od. 15.526", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": ["Lacon."]}, {"kind": "text", "text": "; arms or feelers of a polypus,"}, {"kind": "citation", "text": "Hes. Op. 524", "author_abbreviation": "Hes.", "tlg_author": "0020", "tlg_work": "002", "dialects": ["Lacon."]}, {"kind": "text", "text": ": properly the foot from the ankle down wards,"}, {"kind": "citation", "text": "Il. 17.386", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": ["Lacon."]}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ταρσὸς ποδός 11.377", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": ["Lacon."]}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "388", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": ["Lacon."]}, {"kind": "text", "text": "; ξύλινος π., of an artificial foot,"}, {"kind": "citation", "text": "Hdt. 9.37", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": ["Lacon."]}, {"kind": "text", "text": ": but also of the leg with the foot, as χείρ for the arm and hand,"}, {"kind": "citation", "text": "Il. 23.772", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": ["Lacon."]}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Od. 4.149", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": ["Lacon."]}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Luc. Alex. 59", "author_abbreviation": "Luc.", "tlg_author": "0062", "tlg_work": "038", "dialects": ["Lacon."]}, {"kind": "text", "text": ". foot as that with which one runs,"}, {"kind": "citation", "text": "πόδας ὠκὺς Ἀχιλλεύς Il. 1.215", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", al.; or walks,"}, {"kind": "citation", "text": "τῷ δ' ὑπὸ ποσσὶ μέγας πελεμίζετ' Ὄλυμπος 8.443", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; freq. with reference to swiftness,"}, {"kind": "citation", "text": "περιγιγνόμεθ' ἄλλων πύξ τε . . ἠδὲ πόδεσσιν Od. 8.103", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; ποσὶν ἐρίζειν to race on foot,"}, {"kind": "citation", "text": "Il. 13.325", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "23.792", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πόδεσσι πάντας ἐνίκα 20.410", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Od. 13.261", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἀέθλια ποσσὶν ἄροντο Il. 9.124", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; ποδῶν τιμά, αἴγλα, ἀρετά, ὁρμά,"}, {"kind": "citation", "text": "Pi. O. 12.15", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "13.36", "author_abbreviation": null, "tlg_author": "0033", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "P. 10.23", "author_abbreviation": null, "tlg_author": "0033", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "B. 9.20", "author_abbreviation": "B.", "tlg_author": "0199", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἅμιλλαν ἐπόνει ποδοῖν E. IA 213", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "018", "dialects": []}, {"kind": "text", "text": "(lyr.): the dat. ποσί (ποσσί, πόδεσσι) is added to many Verbs denoting motion, π. βήσετο, παρέδραμον,"}, {"kind": "citation", "text": "Il. 8.389", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "23.636", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; π. θέειν, πηδᾶν, σκαίρειν, πλίσσεσθαι, ib."}, {"kind": "citation", "text": "622", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "21.269", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "18.572", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Od. 6.318", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ὀρχεῖσθαι Hes. Th. 3", "author_abbreviation": "Hes.", "tlg_author": "0020", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἔρχεσθαι Od. 6.39", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πάρος ποσὶν οὖδας ἱκέσθαι 8.376", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "νέρθε δὲ ποσσὶν ἤϊε μακρὰ βιβάς Il. 7.212", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; also emphatically with Verbs denoting to trample or tread upon,"}, {"kind": "citation", "text": "πόσσι καταστείβοισι Sapph. 94", "author_abbreviation": "Sapph.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐπεμβῆναι ποδί S. El. 456", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "; πόδα βαίνειν, v. βαίνω"}, {"kind": "citation", "text": "A. 11.4", "author_abbreviation": "A.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "; πόδα τιθέναι to journey,"}, {"kind": "citation", "text": "Ar. Th. 1100", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": ": metaph., νόστιμον ναῦς ἐκίνησεν πόδα started on its homeward way,"}, {"kind": "citation", "text": "E. Hec. 940", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": "(lyr.); νεῶν λῦσαι ποθοῦσιν οἴκαδ' . . πόδα ib."}, {"kind": "citation", "text": "1020", "author_abbreviation": null, "tlg_author": "0006", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": "; χειρῶν ἔκβαλλον ὀρείους πόδας ναός, i. e. oars,"}, {"kind": "citation", "text": "Tim. Pers. 102", "author_abbreviation": "Tim.", "tlg_author": "0376", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; φωνὴ τῶν π. τοῦ ὑετοῦ sound of the pattering of rain,"}, {"kind": "citation", "text": "LXX 3 Ki. 18.41", "author_abbreviation": "LXX", "tlg_author": "0527", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": ". as a point of measurement, ἐς πόδας ἐκ κεφαλῆς from head to foot,"}, {"kind": "citation", "text": "Il. 18.353", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐκ κεφαλῆς ἐς πόδας ἄκρους 16.640", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; and reversely,"}, {"kind": "citation", "text": "ἐκ ποδῶν δ' ἄνω . . εἰς ἄκρον κάρα A. Fr. 169", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐκ τῶν ποδῶν ἐς τὴν κεφαλήν σοι Ar. Pl. 650", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": "; also"}, {"kind": "citation", "text": "ἐκ τριχὸς ἄχρι ποδῶν AP 5.193", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "("}, {"kind": "citation", "text": "Posidipp.", "author_abbreviation": "Posidipp.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "or"}, {"kind": "citation", "text": "Asclep.", "author_abbreviation": "Asclep.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "); ἐς κορυφὰν ἐκ ποδός ib."}, {"kind": "citation", "text": "7.388", "author_abbreviation": null, "tlg_author": "0137", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(Bianor). πρόσθε ποδός or ποδῶν, προπάροιθε ποδῶν, just before one,"}, {"kind": "citation", "text": "Il. 23.877", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "21.601", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "13.205", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τὸ πρὸ ποδὸς . . χρῆμα Pi. I. 8(7).13", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "αὐτὰ τὰ πρὸ τῶν ποδῶν ὁρᾶν X. Lac. 3.4", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "010", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "An. 4.6.12", "author_abbreviation": null, "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Pl. R. 432d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ". παρά or πὰρ ποδός off-hand, at once,"}, {"kind": "citation", "text": "ἀνελέσθαι πὰρ ποδός Thgn. 282", "author_abbreviation": "Thgn.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "γνόντα τὸ πὰρ ποδός Pi. P. 3.60", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "10.62", "author_abbreviation": null, "tlg_author": "0033", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πὰρ ποδί close at hand, Id. O. 1.74", "author_abbreviation": "Id.", "tlg_author": "0033", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; but παραὶ ποσὶ κάππεσε θυμός sank to their feet,"}, {"kind": "citation", "text": "Il. 15.280", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "παρὰ πόδα in a moment, S. Ph. 838", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "(lyr.),"}, {"kind": "citation", "text": "Pl. Sph. 242a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": "; close behind, Νέμεσις δέ γε πὰρ πόδας (leg. πόδα) βαίνει Prov. ap."}, {"kind": "citation", "text": "Suid.", "author_abbreviation": "Suid.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "; also"}, {"kind": "citation", "text": "παρὰ πόδας immediately afterwards Plb. 1.35.3", "author_abbreviation": "Plb.", "tlg_author": "0543", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "5.26.13", "author_abbreviation": null, "tlg_author": "0543", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Gal. 5.272", "author_abbreviation": "Gal.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "παρὰ π. οἱ ἔλεγχοι Luc. Hist. Conscr. 13", "author_abbreviation": "Luc.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Aristid. 2.115", "author_abbreviation": "Aristid.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "citation", "text": "J.", "author_abbreviation": "J.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τὰ ἔμπροσθεν αὐτοῦ καὶ παρὰ πόδας at his very feet, Pl. Tht. 174a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; περὶ τῶν παρὰ πόδας καὶ τῶν ἐν ὀφθαλμοῖς ib.c;"}, {"kind": "citation", "text": "τὸ πλησίον καὶ παρὰ π. Luc. Cal. 1", "author_abbreviation": "Luc.", "tlg_author": "0062", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": ". ἐν ποσί in one's way, close at hand,"}, {"kind": "citation", "text": "τὸν ἐν π. γινόμενον Hdt. 3.79", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Pi. P. 8.32", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τἀν ποσὶν κακά S. Ant. 1327", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "E. Andr. 397", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τοὐν ποσὶν κακόν Id. Alc. 739", "author_abbreviation": "Id.", "tlg_author": "0006", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τὴν ἐν ποσὶ [κώμην] αἱρεῖν Th. 3.97", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τὰ ἐν ποσὶν ἀγνοεῖν everyday matters, Pl. Tht. 175b", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Arist. Pol. 1263a18", "author_abbreviation": "Arist.", "tlg_author": "0086", "tlg_work": "035", "dialects": []}, {"kind": "text", "text": ", etc. τὸ πρὸς ποσί, = τὸ ἐν ποσί ,"}, {"kind": "citation", "text": "S. OT 130", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ". all these phrases are opp. ἐκ ποδῶν out of the way, far off, written"}, {"kind": "citation", "text": "ἐκποδών Hdt. 6.35", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; also,"}, {"kind": "citation", "text": "βίαια πάντ' ἐκ ποδὸς ἐρύσαις Pi. N. 7.67", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ". to denote close pursuit, ἐκ ποδὸς ἕπεσθαι follow in the track, i.e. close behind,"}, {"kind": "citation", "text": "Plb. 3.68.1", "author_abbreviation": "Plb.", "tlg_author": "0543", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "D.S. 20.57", "author_abbreviation": "D.S.", "tlg_author": "0060", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "D.H. 2.33", "author_abbreviation": "D.H.", "tlg_author": "0081", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.;"}, {"kind": "citation", "text": "ἐκ ποδῶν διώξαντες Plu. Pel. 11", "author_abbreviation": "Plu.", "tlg_author": "0007", "tlg_work": "021", "dialects": []}, {"kind": "text", "text": ". in earlier writers κατὰ πόδας on the heels of a person,"}, {"kind": "citation", "text": "Hdt. 5.98", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Th. 3.98", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "8.17", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "X. HG 2.1.20", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "LXX Ge. 49.19", "author_abbreviation": "LXX", "tlg_author": "0527", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(also"}, {"kind": "citation", "text": "κατὰ πόδα ὑπολαβεῖν on the moment, Pl. Sph. 243d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": "); ἡ κατὰ πόδας ἡμέρα the very next day,"}, {"kind": "citation", "text": "Plb. 1.12.1", "author_abbreviation": "Plb.", "tlg_author": "0543", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(but κατὰ πόδας αἱρεῖν catch it running,"}, {"kind": "citation", "text": "X. Cyr. 1.6.40", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Mem. 2.6.9", "author_abbreviation": null, "tlg_author": "0032", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "): c. gen. pers., κατὰ πόδας τινὸς ἐλαύνειν, ἰέναι, march, come close at his heels, on his track,"}, {"kind": "citation", "text": "Hdt. 9.89", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Th. 5.64", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; τῇ κατὰ π. ἡμέρᾳ τῆς ἐκκλησίας on the day immediately after it,"}, {"kind": "citation", "text": "Plb. 3.45.5", "author_abbreviation": "Plb.", "tlg_author": "0543", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "κατὰ π. τῆς μάχης Aristid. 1.157J.", "author_abbreviation": "Aristid.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ", etc. various phrases:"}, {"kind": "citation", "text": "ἀνὰ πόδα backwards, Hsch.", "author_abbreviation": "Hsch.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "ἐπὶ πόδα backwards facing the enemy, ἐπὶ π. ἀναχωρεῖν, ἀνάγειν, ἀναχάζεσθαι, to retire without turning to fly, leisurely,"}, {"kind": "citation", "text": "X. An. 5.2.32", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Cyr. 3.3.69", "author_abbreviation": null, "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "7.1.34", "author_abbreviation": null, "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ", etc.; also"}, {"kind": "citation", "text": "ἐπὶ πόδας Luc. Pisc. 12", "author_abbreviation": "Luc.", "tlg_author": "0062", "tlg_work": "025", "dialects": []}, {"kind": "text", "text": "; but γίνεται ἡ ἔξοδος οἷον ἐπὶ πόδας the offspring is as it were born feetforemost,"}, {"kind": "citation", "text": "Arist. GA 752b14", "author_abbreviation": "Arist.", "tlg_author": "0086", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": ". περὶ πόδα, properly of a shoe, round the foot, i.e. fitting exactly,"}, {"kind": "citation", "text": "ὡς ἔστι μοι τὸ χρῆμα τοῦτο περὶ πόδα Pl.Com. 197", "author_abbreviation": "Pl.Com.", "tlg_author": "0497", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "129", "author_abbreviation": null, "tlg_author": "0497", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": c. dat.,"}, {"kind": "citation", "text": "ὁρᾷς ὡς ἐμμελὴς ἡ ἀρχὴ καὶ περὶ πόδα τῇ ἱστορίᾳ Luc. Hist.Conscr. 14", "author_abbreviation": "Luc.", "tlg_author": "0062", "tlg_work": "053", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Ind. 10", "author_abbreviation": null, "tlg_author": "0062", "tlg_work": "028", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Pseudol. 23", "author_abbreviation": null, "tlg_author": "0062", "tlg_work": "049", "dialects": []}, {"kind": "text", "text": ". ὡς ποδῶνἔχει as he is off for feet, i. e. as quick as he can,"}, {"kind": "citation", "text": "ὡς ποδῶν εἶχον [τάχιστα] ἐβοήθεον Hdt. 6.116", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐδίωκον ὡς ποδῶν ἕκαστος εἶχον Id. 9.59", "author_abbreviation": "Id.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "φευκτέον ὡς ἔχει ποδῶν ἕκαστος Pl. Grg. 507d", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": "; so,"}, {"kind": "citation", "text": "σοῦσθε . . ὅπως ποδῶν <ἔχετε> A. Supp. 837", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(lyr.). ἔξω τινὸς πόδα ἔχειν keep one's foot out of a thing, i. e. be clear of it,"}, {"kind": "citation", "text": "ἔξω κομίζων πηλοῦ πόδα Id. Ch. 697", "author_abbreviation": "Id.", "tlg_author": "0085", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "πημάτων ἔξω πόδα ἔχει Id. Pr. 265", "author_abbreviation": "Id.", "tlg_author": "0085", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐκτὸς κλαυμάτων S. Ph. 1260", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἔξω πραγμάτων E. Heracl. 109", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ": without a gen., ἐκτὸς ἔχειν πόδα"}, {"kind": "citation", "text": "Pi. P. 4.289", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ": opp."}, {"kind": "citation", "text": "εἰς ἄντλον ἐμβήσῃ πόδα E. Heracl. 168", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐν τούτῳ πεδίλῳ . . πόδ' ἔχων Pi. O. 6.8", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". ἀμφοῖν ποδοῖν, etc., to denote energetic action,"}, {"kind": "citation", "text": "Ar. Av. 35", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Il. 13.78", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "συνέχευε ποσὶν καὶ χερσὶν 15.364", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "χερσίν τε ποσίν τε καὶ σθένει 20.360", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "τιμωρήσειν χειρὶ καὶ ποδὶ καὶ πάσῃ δυνάμει Aeschin. 2.115", "author_abbreviation": "Aeschin.", "tlg_author": "0026", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "3.109", "author_abbreviation": null, "tlg_author": "0026", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; τερπωλῆς ἐπέβημεν ὅλῳ ποδί with all the foot, i.e. entirely,"}, {"kind": "citation", "text": "A.R. 4.1166", "author_abbreviation": "A.R.", "tlg_author": "0001", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "D.Chr. 13.19", "author_abbreviation": "D.Chr.", "tlg_author": "0612", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(prob.);"}, {"kind": "citation", "text": "καταφεύγειν ἐπὶ τὴν πόλιν ὥσπερ ἐκ δυοῖν ποδοῖν Aristid. 1.117J.", "author_abbreviation": "Aristid.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "; opp."}, {"kind": "citation", "text": "οὐκ ἂν προβαίην τὸν πόδα τὸν ἕτερον Ar. Ec. 161", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "010", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "οὐκ ἂν ἔφασκεν ἐξελθεῖν οὐδὲ τὸν ἕτερον πόδα Din. 1.82", "author_abbreviation": "Din.", "tlg_author": "0029", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". τὴν ὑπὸ πόδα [κατάστασιν] just below them,"}, {"kind": "citation", "text": "Plb. 2.68.9", "author_abbreviation": "Plb.", "tlg_author": "0543", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ὑπὸ πόδας τίθεσθαι trample under foot, scorn,"}, {"kind": "citation", "text": "Plu. 2.1097c", "author_abbreviation": "Plu.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "; οἱ ὑπὸ πόδα those next below them (in rank),"}, {"kind": "citation", "text": "Onos. 25.2", "author_abbreviation": "Onos.", "tlg_author": "0648", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ὑπὸ πόδα χωρεῖν recede, decline, of strength,"}, {"kind": "citation", "text": "Ath.", "author_abbreviation": "Ath.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "Med. ap."}, {"kind": "citation", "text": "Orib.", "author_abbreviation": "Orib.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "inc."}, {"kind": "citation", "text": "21.16", "author_abbreviation": null, "tlg_author": "0722", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". for ὀρθῷ ποδί, v. ὀρθός"}, {"kind": "citation", "text": "11.1", "author_abbreviation": null, "tlg_author": "0722", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". ἁλιεῖς ἀπὸ ποδός prob. fishermen who fish from the land, not from boats,"}, {"kind": "citation", "text": "BGU 221.5", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "("}, {"kind": "citation", "text": "i1", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "/iii A. D.); ποτίσαι ἀπὸ ποδός perh. irrigate by the feet (of oxen turning the irrigation-wheel),"}, {"kind": "citation", "text": "PRyl. 157.21", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(ii A. D.); τόπον . . ἀπὸ ποδὸς ἐξηρτισμένον dub. sens. in"}, {"kind": "citation", "text": "POsl. 55.11", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(ii/iii A. D.)."}, {"kind": "citation", "text": "ἀγγεῖον . . τρήματα ἐκ τῶν ὑπὸ ποδὸς ἔχον round the bottom, Dsc. 2.72", "author_abbreviation": "Dsc.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ". πούς τινος, as periphr. for a person as coming, etc., σὺν πατρὸς μολὼν ποδί, i.e. σὺν πατρί,"}, {"kind": "citation", "text": "E. Hipp. 661", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "παρθένου δέχου πόδα Id. Or. 1217", "author_abbreviation": "Id.", "tlg_author": "0006", "tlg_work": "016", "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Hec. 977", "author_abbreviation": null, "tlg_author": "0006", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "HF 336", "author_abbreviation": null, "tlg_author": "0006", "tlg_work": "009", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "χρόνου πόδα Id. Ba. 889", "author_abbreviation": "Id.", "tlg_author": "0006", "tlg_work": "017", "dialects": []}, {"kind": "text", "text": "(lyr.),"}, {"kind": "citation", "text": "Ar. Ra. 100", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "009", "dialects": []}, {"kind": "text", "text": "; also ἐξ ἑνὸς ποδός, i.e. μόνος ὤν,"}, {"kind": "citation", "text": "S. Ph. 91", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "006", "dialects": []}, {"kind": "text", "text": "; οἱ δ' ἀφ' ἡσύχου π., i.e. οἱ ἡσύχως ζῶντες,"}, {"kind": "citation", "text": "E. Med. 217", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ". metaph., of things, foot, lowest part, esp. foot of a hill,"}, {"kind": "citation", "text": "Il. 2.824", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "20.59", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(pl.),"}, {"kind": "citation", "text": "Pi. P. 11.36", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", etc.; of a table, couch, etc.,"}, {"kind": "citation", "text": "Ar. Fr. 530", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "012", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "X. Cyr. 8.8.16", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ", etc.; cf. πέζα; of the side strokes at the foot of the letter Ω, Callias ap."}, {"kind": "citation", "text": "Ath. 10.454a", "author_abbreviation": "Ath.", "tlg_author": "0008", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; = ποδεών"}, {"kind": "citation", "text": "11.1", "author_abbreviation": null, "tlg_author": "0008", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "ἀσκοῦ . . λῦσαι π. E. Med. 679", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ". in a ship, πόδες are the two lower corners of the sail, or the ropes fastened therelo, by which the sails are tightened or slackened, sheets (cf."}, {"kind": "citation", "text": "ποδεών 11.4", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "),"}, {"kind": "citation", "text": "Od. 5.260", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; χαλᾶν πόδα ease off the sheet, as is done when a squall is coming,"}, {"kind": "citation", "text": "E. Or. 707", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "016", "dialects": []}, {"kind": "text", "text": "; τοῦ ποδὸς παρίει let go hold of it,"}, {"kind": "citation", "text": "Ar. Eq. 436", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἐκδοῦναι ὀλίγον τοῦ ποδός Luc. Cont. 3", "author_abbreviation": "Luc.", "tlg_author": "0062", "tlg_work": "023", "dialects": []}, {"kind": "text", "text": "; ἐκπετάσουσι πόδα ναός (with reference to the sail),"}, {"kind": "citation", "text": "E. IT 1135", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": "(lyr.): opp. τεῖναι πόδα haul it tight,"}, {"kind": "citation", "text": "S. Ant. 715", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; ναῦς ἐνταθεῖσα ποδί a ship with her sheet close hauled,"}, {"kind": "citation", "text": "E. Or. 706", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "016", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "κὰδ' δ' . . λαῖφος ἐρυσσάμενοι τανύοντο ἐς πόδας ἀμφοτέρους A.R. 2.932", "author_abbreviation": "A.R.", "tlg_author": "0001", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "ἱστία . . ἐτάνυσσαν ὑπ' ἀμφοτέροισι πόδεσσι Q.S. 9.438", "author_abbreviation": "Q.S.", "tlg_author": "2046", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". perh. of the rudder or steering-paddle,"}, {"kind": "citation", "text": "αἰεὶ γὰρ πόδα νηὸς ἐνώμων Od. 10.32", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "(cf. Sch.ad loc.);"}, {"kind": "citation", "text": "πὰρ ποδὶ ναός Pi. N. 6.55", "author_abbreviation": "Pi.", "tlg_author": "0033", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ". a foot, as a measure of length, ="}, {"kind": "citation", "text": "4", "author_abbreviation": null, "tlg_author": "0033", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "palms (παλασταί) or"}, {"kind": "citation", "text": "6", "author_abbreviation": null, "tlg_author": "0033", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "fingers,"}, {"kind": "citation", "text": "Hdt. 2.149", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Pl. Men. 82c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "024", "dialects": []}, {"kind": "text", "text": ", etc. foot in Prosody,"}, {"kind": "citation", "text": "Ar. Ra. 1323", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "009", "dialects": []}, {"kind": "text", "text": "(lyr.),"}, {"kind": "citation", "text": "Pl. R. 400a", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Aristox. Harm. p.34", "author_abbreviation": "Aristox.", "tlg_author": "0088", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "M.,"}, {"kind": "citation", "text": "Heph. 3.1", "author_abbreviation": "Heph.", "tlg_author": "1402", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; so of a metrical phrase or passage,"}, {"kind": "citation", "text": "ἔκμετρα καὶ ὑπὲρ τὸν π. Luc. Pr.Im. 18", "author_abbreviation": "Luc.", "tlg_author": "0062", "tlg_work": "040", "dialects": []}, {"kind": "text", "text": "; of a long passage declaimed in one breath,"}, {"kind": "citation", "text": "κήρυκες ὅταν τὸν καλούμενον πόδα μέλλωσιν ἐρεῖν Gal. 4.459", "author_abbreviation": "Gal.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ", cf."}, {"kind": "citation", "text": "Luc. Demon. 65", "author_abbreviation": "Luc.", "tlg_author": "0062", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Poll. 4.91", "author_abbreviation": "Poll.", "tlg_author": "0542", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". boundary stone,"}, {"kind": "citation", "text": "Is. Fr. 27", "author_abbreviation": "Is.", "tlg_author": "0017", "tlg_work": "013", "dialects": []}, {"kind": "text", "text": ". (Cf. Lat. pes, Goth. fotus, etc. 'foot'; related to πέδον as noted by"}, {"kind": "citation", "text": "Ari