{"format_version": 2, "segments": [{"kind": "text", "text": "ἐπικέλλω, aor. 1 ἐπέκελσα, also"}, {"kind": "citation", "text": "ἐπέκειλα Act.Ap. 27.41", "author_abbreviation": null, "tlg_author": "0031", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ": fut. part. acc."}, {"kind": "citation", "text": "ἐπι—κέλσοντα Numen.", "author_abbreviation": "Numen.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(v. infr.):—bring ships to shore,"}, {"kind": "citation", "text": "νῆας ἐπικέλσαι Od. 9.148", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ", cf. Act.Ap.l.c. . abs., run ashore,"}, {"kind": "citation", "text": "Od. 9.138", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ";"}, {"kind": "citation", "text": "χέρσῳ ἐ. ἐρετμοῖς A.R. 3.575", "author_abbreviation": "A.R.", "tlg_author": "0001", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": c.acc., γῆν ἐ."}, {"kind": "citation", "text": "Id. 2.352", "author_abbreviation": "Id.", "tlg_author": "0001", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; also of the ship itself,"}, {"kind": "citation", "text": "ἡ μὲν ἔπειτα ἠπείρῳ ἐπέκελσεν Od. 13.114", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; of a fish, rush into the net,"}, {"kind": "citation", "text": "Numen.", "author_abbreviation": "Numen.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "ap."}, {"kind": "citation", "text": "Ath. 7.321b", "author_abbreviation": "Ath.", "tlg_author": "0008", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(cj. for ἐπιτέλσωντα)."}]}