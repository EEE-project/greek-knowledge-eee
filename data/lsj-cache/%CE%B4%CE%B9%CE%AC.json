d": "citation", "text": "POxy. 1070.15", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "(iii A. D.). of Manner (where διά with its Noun freq. serves as an Adv.),"}, {"kind": "citation", "text": "δ. μέθης ποιήσασθαι τὴν συνουσίαν Pl. Smp. 176e", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": "; παίω δι' ὀργῆς through passion, in passion,"}, {"kind": "citation", "text": "S. OT 807", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "; δ. τάχους, = ταχέως ,"}, {"kind": "citation", "text": "Id. Aj. 822", "author_abbreviation": "Id.", "tlg_author": "0011", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Th. 1.63", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "(but δ. ταχέων ib."}, {"kind": "citation", "text": "80", "author_abbreviation": null, "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", al.); δ. σπουδῆς in haste, hastily,"}, {"kind": "citation", "text": "E. Ba. 212", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "017", "dialects": []}, {"kind": "text", "text": "; δι' αἰδοῦς with reverence, respectfully, ib."}, {"kind": "citation", "text": "441", "author_abbreviation": null, "tlg_author": "0006", "tlg_work": "017", "dialects": []}, {"kind": "text", "text": "; δ. ψευδῶν ἔπη lying words,"}, {"kind": "citation", "text": "Id. Hel. 309", "author_abbreviation": "Id.", "tlg_author": "0006", "tlg_work": "014", "dialects": []}, {"kind": "text", "text": "; αἱ δ. καρτερίας ἐπιμέλειαι long-continued exertions,"}, {"kind": "citation", "text": "X. Mem. 2.1.20", "author_abbreviation": "X.", "tlg_author": "0032", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; δι' ἀκριβείας, δ. πάσης ἀκρ.,"}, {"kind": "citation"