2", "author_abbreviation": null, "tlg_author": "0031", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": "; of divine punishment, "}, {"kind": "citation", "text": "ἐγώ εἰμι Κύριος ὁ τύπτων LXX Ez. 7.6(9)", "author_abbreviation": "LXX", "tlg_author": "0527", "tlg_work": "053", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "τύπτειν σε μέλλει ὁ θεός Act.Ap. 23.3", "author_abbreviation": null, "tlg_author": "0031", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": ". strike a coin, "}, {"kind": "citation", "text": "ἐξ ἀργύρου τυπτόμενον νόμισμα Hero", "author_abbreviation": "Hero", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": " *Mens. "}, {"kind": "citation", "text": "60", "author_abbreviation": null, "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ". Med. τύπτομαι, beat, strike oneself, esp., like κόπτομαι , beat one's breast for grief, "}, {"kind": "citation", "text": "Hdt. 2.61", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": c. acc. pers., mourn for a person, ib."}, {"kind": "citation", "text": "42", "author_abbreviation": null, "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "132", "author_abbreviation": null, "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". Pass. , to be beaten, struck, or wounded, "}, {"kind": "citation", "text": "δουρὶ τυπείς Il. 11.191", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ὑπὸ δουρί ib."}, {"kind": "citation", "text": "433", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "δορὸς ὕπο Ar. Ach. 1194", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": " (lyr.); "}, {"kind": "citation", "text": "κράτων τυπτομένων Od. 22.309", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ". c. acc. cogn., receive blows or wounds, "}, {"kind": "citation", "text": "ἕλκεα . . ὅσσ' ἐτύπη Il. 24.421", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; τύπτομαι πολλάς (sc. πληγάς) I get many blows, "}, {"kind": "citation", "text": "Ar. Nu. 972", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": " (anap.), cf. "}, {"kind": "citation", "text": "Pax 644", "author_abbreviation": null, "tlg_author": "0019", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": " (troch.), "}, {"kind": "citation", "text": "Ra. 636", "author_abbreviation": null, "tlg_author": "0019", "tlg_work": "009", "dialects": []}, {"kind": "text", "text": ", Lex ap."}, {"kind": "citation", "text": "Aeschin. 1.139", "author_abbreviation": "Aeschin.", "tlg_author": "0026", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ": c. dat., καιρίῃ (sc. πληγῇ)"}, {"kind": "citation", "text": "τετύφθαι Hdt. 3.64", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; v. supr. "}, {"kind": "citation", "text": "1.1", "author_abbreviation": null, "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". "}]}