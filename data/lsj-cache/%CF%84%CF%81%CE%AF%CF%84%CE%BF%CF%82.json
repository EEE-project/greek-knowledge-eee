ii B. C.); third of a stater,"}, {"kind": "citation", "text": "Herod. 2.64", "author_abbreviation": "Herod.", "tlg_author": "0650", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". τρίτον as Adv., thirdly,"}, {"kind": "citation", "text": "S. Ant. 55", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Fr. 380", "author_abbreviation": null, "tlg_author": "0011", "tlg_work": "008", "dialects": []}, {"kind": "text", "text": "; a third time,"}, {"kind": "citation", "text": "E. Hel. 1417", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "014", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Aristid. 2.182", "author_abbreviation": "Aristid.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "citation", "text": "J.", "author_abbreviation": "J.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "; πρῶτον μὲν . . , δεύτερον δὲ . . , τ. δὲ . ."}, {"kind": "citation", "text": "Pl. R. 358c", "author_abbreviation": "Pl.", "tlg_author": "0059", "tlg_work": "030", "dialects": []}, {"kind": "text", "text": "; τοῦτο τ. this third time,"}, {"kind": "citation", "text": "LXX Nu. 22.32", "author_abbreviation": "LXX", "tlg_author": "0527", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "Ev.Jo. 21.14", "author_abbreviation": null, "tlg_author": "0031", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": ":—in"}, {"kind": "citation", "text": "Hom.", "author_abbreviation": "Hom.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "always τὸ τρίτον,"}, {"kind": "citation", "text": "Il. 3.225", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ","}, {"kind": "citation", "text": "6.186", "author_abbreviation": null, "tlg_author": "0012", "tlg_wor