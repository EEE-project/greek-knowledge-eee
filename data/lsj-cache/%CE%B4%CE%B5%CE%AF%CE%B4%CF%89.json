_author": "0059", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". part. pf., τὸ δεδιός one's fearing, much like δέος ,"}, {"kind": "citation", "text": "Th. 1.36", "author_abbreviation": "Th.", "tlg_author": "0003", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ". flee from, c. acc. (by assimilation to φοβήσομαι),"}, {"kind": "citation", "text": "Il. 22.251", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "."}]}