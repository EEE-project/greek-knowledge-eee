 {"kind": "citation", "text": "θ. ἐνὶ στήθεσσι γεγήθει 13.494", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "μιν ἄχος κραδίην καὶ θ. ἵκανεν 2.171", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἄχνυτο θ. "}, {"kind": "citation", "text": "14.39", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; δόκησε δ' ἄρα σφίσι θ. ὣς ἔμεν ὡς εἰ . . they felt as glad at heart as if . . , "}, {"kind": "citation", "text": "Od. 10.415", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; μηδ' ὀνίαισι δάμνα . . θ. "}, {"kind": "citation", "text": "Sapph. 1.4", "author_abbreviation": "Sapph.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": "; of fear, "}, {"kind": "citation", "text": "δέος ἔμπεσε θυμῷ Il. 17.625", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf. "}, {"kind": "citation", "text": "8.138", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; of love, "}, {"kind": "citation", "text": "τὴν ἐκ θυμοῦ φίλεον 9.343", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐκ θυμοῦ στέργοισα Theoc. 17.130", "author_abbreviation": "Theoc.", "tlg_author": "0005", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἐμῷ κεχαρισμένε θυμῷ my heart's beloved, "}, {"kind": "citation", "text": "Il. 5.243", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; reversely, ἀπὸ θ. μᾶλλον ἐμοὶ ἔσεαι wilt be alien from my heart, "}, {"kind": "citation", "text": "1.562", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; ἐκ θ. πεσέειν, i.e. to lose thy favour, "}, {"kind": "citation", "text": "23.595", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἔρωτι θυμὸν ἐκπλαγεῖσα E. Med. 8", "author_abbreviation": "E.", "tlg_author": "0006", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐκ θ. κλαῦσαι Philet. 11", "author_abbreviation": "Philet.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ". mind, soul, as the seat of thought, ταῦθ' ὥρμαινε κατὰ φρένα καὶ κατὰ θ. "}, {"kind": "citation", "text": "Il. 1.193", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; ᾔδεε γὰρ κατὰ θ. "}, {"kind": "citation", "text": "2.409", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", cf. "}, {"kind": "citation", "text": "4.163", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", etc.; "}, {"kind": "citation", "text": "φράζετο θυμῷ 16.646", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐν θ. ἐβάλοντο ἔπος 15.566", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "τοὺς λόγους θυμῷ βάλε A. Pr. 706", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "εἰς θ. βαλεῖν τι S. OT 975", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "004", "dialects": []}, {"kind": "text", "text": "; οὐκ ἐς θ. φέρω I bring him