{"format_version": 2, "segments": [{"kind": "text", "text": " αὐτοῦ, αὐτῶ and αὐτεῖ, Adv., prop. gen. of αὐτός:— just there or just here, "}, {"kind": "citation", "text": "Hom.", "author_abbreviation": "Hom.", "tlg_author": null, "tlg_work": null, "dialects": []}, {"kind": "text", "text": ", etc.; ἐπίσχες αὐτοῦ stop there! "}, {"kind": "citation", "text": "Cratin. 66", "author_abbreviation": "Cratin.", "tlg_author": "0434", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ":—freq. with the place added, αὐτοῦ ἐνὶ Τροίῃ, μέν' αὐτοῦ τῷδ' ἐνὶ χώρῳ, here in Troy, etc., "}, {"kind": "citation", "text": "Il. 2.237", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Od. 10.271", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "αὐτοῦ ἔνθα Il. 8.207", "author_abbreviation": "Il.", "tlg_author": "0012", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; που αὐτοῦ ἀγρῶν somewhere there on the farm, "}, {"kind": "citation", "text": "Od. 4.639", "author_abbreviation": "Od.", "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "αὐτοῦ ὑπὲρ κεφαλῆς 8.68", "author_abbreviation": null, "tlg_author": "0012", "tlg_work": "002", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "αὐτοῦ περὶ τεῖχος A. Ag. 452", "author_abbreviation": "A.", "tlg_author": "0085", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": " (lyr.); αὐτοῦ ταύτῃ in this very place, exactly here, "}, {"kind": "citation", "text": "Hdt. 1.214", "author_abbreviation": "Hdt.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "3.77", "author_abbreviation": null, "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "4.135", "author_abbreviation": null, "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "αὐτοῦ τῇ περ ἔπεσε Id. 1.30", "author_abbreviation": "Id.", "tlg_author": "0016", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ":— so that αὐτοῦ usu. precedes; but "}, {"kind": "citation", "text": "κεῖθι αὐτοῦ h.Ap. 374", "author_abbreviation": null, "tlg_author": "0013", "tlg_work": "003", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "κατ' οἴκους αὐτοῦ Ar. Pax 89", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "005", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "ἐνθάδ' αὐτοῦ Sol. 36.11", "author_abbreviation": "Sol.", "tlg_author": "0263", "tlg_work": "001", "dialects": []}, {"kind": "text", "text": ", "}, {"kind": "citation", "text": "Ar. Pl. 1187", "author_abbreviation": "Ar.", "tlg_author": "0019", "tlg_work": "011", "dialects": []}, {"kind": "text", "text": "; "}, {"kind": "citation", "text": "τοῖς ἐνθάδ' αὐτοῦ μὴ κατ' ἄστυ δημόταις S. OC 78", "author_abbreviation": "S.", "tlg_author": "0011", "tlg_work": "007", "dialects": []}, {"kind": "text", "text": ". "}]}