word": "φόβος"}], "synonyms": [{"word": "αγριεύομαι"}, {"word": "αγρούμαι"}], "translations": [{"word": "fear", "lang_code": "en", "lang": "English"}, {"word": "afraid", "lang_code": "en", "lang": "English"}, {"word": "peur", "lang_code": "fr", "lang": "français"}, {"word": "craindre", "lang_code": "fr", "lang": "français"}, {"word": "criembre", "lang_code": "fro"}, {"word": "Angst haben", "lang_code": "de", "lang": "Deutsch"}, {"word": "sich ängstigen", "lang_code": "de", "lang": "Deutsch"}, {"word": "paventare", "lang_code": "it", "lang": "italiano"}, {"word": "temere", "lang_code": "it", "lang": "italiano"}, {"word": "avere paura di", "lang_code": "it", "lang": "italiano"}, {"word": "бојати се", "lang_code": "sr", "lang": "српски / srpski"}, {"word": "korkmak", "lang_code": "tr", "lang": "Türkçe"}]}