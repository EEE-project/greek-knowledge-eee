ση ή το πολύτιμο πρόσωπο που ενσαρκώνει την προσδοκία για κάτι θετικό"], "examples": [{"text": "Το λαχείο είναι η τελευταία μου ελπίδα."}, {"text": "Ο νέος προπονητής είναι η τελευταία τους ελπίδα για αξιοπρεπή παρουσία φέτος."}]}], "categories": ["Κληρονομημένες λέξεις από τα αρχαία ελληνικά (νέα ελληνικά)", "Κληρονομημένες λέξεις από τα μεσαιωνικά ελληνικά (νέα ελληνικά)", "Προέλευση λέξεων από τα αρχαία ελληνικά (νέα ελληνικά)", "Προέλευση λέξεων από τα μεσαιωνικά ελληνικά (νέα ελληνικά)"], "sounds": [{"ipa": "elˈpi.ða"}], "hyphenation": "ελ‐πί‐δα", "form_of": [{"word": "ελπίς"}, {"word": "έλπιση"}], "antonyms": [{"word": "απελπισία"}], "related": [{"word": "φρούδες ελπίδες"}, {"word": "η ελπίδα πεθαίνει πάντα τελευταία"}, {"word": "δυσοόωνες"}, {"word": "πάμε στο άγνωστο με βάρκα την ελπίδα"}, {"word": "ομάδα ελπίδων"}, {"word": "παρ' ελπίδα"}, {"word": "ανέλπιδα", "raw_tags": ["επίρρημα"], "tags": ["adverb"]}, {"word": "ανέλπιδος"}, {"word": "ανελπιδοσύνη"}, {"word": "ανελπισιά"}, {"word": "ανέλπιστα", "raw_tags": ["επίρρημα"], "tags": ["adverb"]}, {"word": "ανελπίστως", "raw_tags": ["επίρρημα"], "tags": ["adverb"]}, {"word": "ανέλπιστος"}, {"word": "απέλπιδα", "raw_tags": ["επίρρημα"], "tags": ["adverb"]}, {"word": "απελπίζω"}, {"word": "απελπίζομαι"}, {"word": "απελπιέμαι"}, {"word": "άπελπις"}, {"word": "απέλπιδος"}, {"word": "απέλπιστος"}, {"word": "απελπισία"}, {"word": "απελπισιά"}, {"word": "απελπισιάρης"}, {"word": "απελπισιάρικος"}, {"word": "απελιπισμένα", "raw_tags": ["επίρρημα"], "tags": ["adverb"]}, {"word": "απελπισμένος"}, {"word": "απελιπιστικά", "raw_tags": ["επίρρημα"], "tags": ["adverb"]}, {"word": "απελπιστικώς", "raw_tags": ["επίρρημα"], "tags": ["adverb"]}, {"word": "απελπιστικός"}, {"word": "δύσελπις"}, {"word": "ελπιδιακός"}, {"word": "ελπιδοπνίχτης"}, {"word": "ελπιδοφόρα", "raw_tags": ["επίρρημα"], "tags": ["adverb"]}, {"word": "ελπιδοφόρος"}, {"word": "ελπιδοφορτωμένος"}, {"word": "ελπιδοφτερουγίζω"}, {"word": "ελπίζω"}, {"word": "έλπ