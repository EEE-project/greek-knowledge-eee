osses": ["παραμερίζω, απομακρύνομαι (κυριολεκτικά ή μεταφορικά)"], "examples": [{"text": "φύγε από μπροστά μου, δεν βλέπω"}, {"text": "μη φεύγεις από το θέμα"}]}, {"glosses": ["απαλλάσσω κάποιον από την παρουσία μου επειδή το θέλω εγώ (τον εγκαταλείπω) ή αυτός (επειδή με θεωρεί εμπόδιο)"], "examples": [{"text": "αν φύγεις θα σκοτωθώ (αν με εγκαταλείψεις ερωτικά, αν χωρίσουμε)"}, {"text": "η Ελλάδα έφυγε από το ΝΑΤΟ εξαιτίας του Κυπριακού (βγήκε, έπαψε να συμμετέχει στο στρατιωτικό σκέλος της συμμαχίας)"}, {"text": "μου ξεκαθάρισε ότι πρέπει να φύγω από τη μέση"}]}, {"glosses": ["παύω να υπάρχω, εξαφανίζομαι"], "examples": [{"text": "να δω πώς θα φύγει τώρα ο λεκές"}, {"text": "πώς φεύγουν έτσι τα λεφτά"}]}, {"glosses": ["διατίθεμαι, πωλούμαι"], "examples": [{"text": "με χαμηλές τιμές φεύγει εύκολα το εμπόρευμα"}]}, {"glosses": ["ξεφεύγω, δραπετεύω"], "examples": [{"text": "ο κατάδικος τους έφυγε μέσα από τα χέρια"}, {"text": "δεν κατάλαβα πώς μου έφυγε το παιδί και βρέθηκε στο δρόμο"}]}, {"glosses": ["μου φεύγει: χάνω τον έλεγχο ενός πράγματος, μου ξεφεύγει"], "examples": [{"text": "του έφυγαν τα τσίσα"}, {"text": "του έφυγε το τιμόνι κι έπεσε στην κολώνα"}, {"text": "είναι εμπιστευτικά όλα αυτά, μη σου φύγει κουβέντα"}]}, {"glosses": ["πεθαίνω"], "tags": ["figuratively"], "raw_tags": ["μεταφορικά"], "categories": ["Μεταφορικοί όροι (νέα ελληνικά)"], "examples": [{"text": "πάει ο κυρ-Κώστας, έφυγε"}]}], "categories": ["Κληρονομημένες λέξεις από τα αρχαία ελληνικά (νέα ελληνικά)", "Κληρονομημένες λέξεις από τα μεσαιωνικά ελληνικά (νέα ελληνικά)", "Προέλευση λέξεων από τα αρχαία ελληνικά (νέα ελληνικά)", "Προέλευση λέξεων από τα μεσαιωνικά ελληνικά (νέα ελληνικά)"], "sounds": [{"ipa": "ˈfe.vɣo"}], "hyphenation": "φεύ‐γω", "related": [{"word": "φευγαλέος"}, {"word": "φευγιό"}, {"word": "φευγατίζω"}, {"word": "φευγάτος"}, {"word": "φυγή"}, {"word": "φυγάς"}, {"word": "αποφεύγω"}, {"word": "διαφεύγω"}, {"word": "προσφεύγω"}, {"word": "καταφεύγω"}, {"word": "ξεφεύγω"}, {"